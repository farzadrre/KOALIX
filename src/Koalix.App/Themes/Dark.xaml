<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- KOALIX dark: deep navy glass. Accent-derived brushes are injected by ThemeService. -->
    <Color x:Key="WindowColor">#FF0A0C13</Color>
    <SolidColorBrush x:Key="WindowBrush" Color="#FF0A0C13"/>
    <SolidColorBrush x:Key="ShellTintBrush" Color="#B30A0C13"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#590E1120"/>
    <LinearGradientBrush x:Key="CardBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#40262C42" Offset="0"/>
        <GradientStop Color="#2614182A" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CardBorderBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#33FFFFFF" Offset="0"/>
        <GradientStop Color="#0AFFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="CardHoverBrush" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="ControlBrush" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#24FFFFFF"/>
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#0DFFFFFF"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="StrongBorderBrush" Color="#3DFFFFFF"/>
    <SolidColorBrush x:Key="TextBrush" Color="#FFF2F4FA"/>
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#FF9AA3B8"/>
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#FF5D6478"/>
    <SolidColorBrush x:Key="InputBrush" Color="#990C0F1A"/>
    <SolidColorBrush x:Key="PopupBrush" Color="#FA141826"/>
    <SolidColorBrush x:Key="SelectionBrush" Color="#33FFFFFF"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#40FFFFFF"/>
    <SolidColorBrush x:Key="TrackBrush" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#FF2EE08A"/>
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#262EE08A"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#FFFFB547"/>
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#26FFB547"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#FFFF5C70"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#26FF5C70"/>
    <Color x:Key="SuccessColor">#FF2EE08A</Color>
    <Color x:Key="DangerColor">#FFFF5C70</Color>
    <Color x:Key="ShadowColor">#FF000000</Color>
    <sys:Double x:Key="AuroraOpacity" xmlns:sys="clr-namespace:System;assembly=mscorlib">0.85</sys:Double>
</ResourceDictionary>
