<UserControl x:Class="Koalix.App.Views.DashboardView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:Koalix.App.Localization" xmlns:c="clr-namespace:Koalix.App.Controls">
  <UserControl.Resources>
    <CubicEase x:Key="PopEase" EasingMode="EaseOut"/>
    <!-- Server card (v0.4.3 UI polish): deep glass fill so cards pop against the hero, bright title text,
         engine glyph, hover fill + border, accent selection. -->
    <Style x:Key="ServerCard" TargetType="Button">
      <Setter Property="Width" Value="235"/>
      <Setter Property="Margin" Value="0,0,10,10"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="root" RenderTransformOrigin="0.5,0.5">
              <Grid.RenderTransform><ScaleTransform/></Grid.RenderTransform>
              <Border x:Name="card" CornerRadius="14" BorderThickness="1" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource CardBorderBrush}" Padding="13,10">
                <ContentPresenter/>
              </Border>
              <Border x:Name="hover" CornerRadius="14" Background="{DynamicResource CardHoverBrush}" Opacity="0" IsHitTestVisible="False"/>
              <!-- v0.4.6: selection pop (accent border flash) + the auto card's breathing aura. -->
              <Border x:Name="selGlow" CornerRadius="14" BorderThickness="1.6" BorderBrush="{DynamicResource AccentBrush}" Opacity="0" IsHitTestVisible="False"/>
              <Border x:Name="autoAura" CornerRadius="14" BorderThickness="1.6" BorderBrush="{DynamicResource AccentBrush}" Opacity="0" IsHitTestVisible="False">
                <Border.Background><SolidColorBrush Color="{DynamicResource AccentColor}" Opacity="0.07"/></Border.Background>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="card" Property="BorderBrush" Value="{DynamicResource StrongBorderBrush}"/>
                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.02" Duration="0:0:0.12"/>
                  <DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.02" Duration="0:0:0.12"/>
                  <DoubleAnimation Storyboard.TargetName="hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.18"/>
                  <DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.18"/>
                  <DoubleAnimation Storyboard.TargetName="hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                </Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
              <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter TargetName="card" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                <Setter TargetName="card" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                <Setter TargetName="card" Property="BorderThickness" Value="1.4"/>
                <!-- v0.4.6: a quick spring pop + accent border flash the moment a card is clicked. -->
                <DataTrigger.EnterActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.035" Duration="0:0:0.11" EasingFunction="{StaticResource PopEase}"/>
                  <DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.035" Duration="0:0:0.11" EasingFunction="{StaticResource PopEase}"/>
                  <DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.22" BeginTime="0:0:0.11"/>
                  <DoubleAnimation Storyboard.TargetName="root" Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.22" BeginTime="0:0:0.11"/>
                  <DoubleAnimation Storyboard.TargetName="selGlow" Storyboard.TargetProperty="Opacity" To="0.9" Duration="0:0:0.1"/>
                  <DoubleAnimation Storyboard.TargetName="selGlow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.55" BeginTime="0:0:0.16"/>
                </Storyboard></BeginStoryboard></DataTrigger.EnterActions>
              </DataTrigger>
              <!-- The auto card breathes while selected: soft accent glow, in and out (v0.4.6). -->
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Binding="{Binding IsAuto}" Value="True"/>
                  <Condition Binding="{Binding IsSelected}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <MultiDataTrigger.EnterActions><BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="autoAura" Storyboard.TargetProperty="Opacity" From="0.25" To="0.95" Duration="0:0:1.2" AutoReverse="True" RepeatBehavior="Forever" EasingFunction="{StaticResource PopEase}"/>
                  </Storyboard>
                </BeginStoryboard></MultiDataTrigger.EnterActions>
                <MultiDataTrigger.ExitActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="autoAura" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3"/>
                </Storyboard></BeginStoryboard></MultiDataTrigger.ExitActions>
              </MultiDataTrigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Protocol chip: colour-coded per protocol (v0.4.3 UI polish) — TROJAN amber, VLESS green, Hysteria2 red, rest accent purple.
         v0.4.13: rounded rectangle (was a full capsule/oval) — user rule: everything is a rectangle with soft corners. -->
    <Style x:Key="ProtoChip" TargetType="Border">
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="8,2"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Source}" Value="TROJAN"><Setter Property="Background" Value="{DynamicResource WarningSoftBrush}"/></DataTrigger>
        <DataTrigger Binding="{Binding Source}" Value="VLESS"><Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}"/></DataTrigger>
        <DataTrigger Binding="{Binding Source}" Value="Hysteria2"><Setter Property="Background" Value="{DynamicResource DangerSoftBrush}"/></DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="ProtoChipText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="10.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontFamily" Value="{StaticResource LatinFont}"/>
      <Setter Property="FlowDirection" Value="LeftToRight"/>
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Source}" Value="TROJAN"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/></DataTrigger>
        <DataTrigger Binding="{Binding Source}" Value="VLESS"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/></DataTrigger>
        <DataTrigger Binding="{Binding Source}" Value="Hysteria2"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/></DataTrigger>
      </Style.Triggers>
    </Style>
    <!-- Engine chip: quiet outlined rectangle so the protocol colour stays the hero (v0.4.3 UI polish; v0.4.13 de-ovalled). -->
    <Style x:Key="EngineChip" TargetType="Border">
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="8,2"/>
      <Setter Property="Margin" Value="6,0,0,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style x:Key="EngineChipText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="10.5"/>
      <Setter Property="FontFamily" Value="{StaticResource LatinFont}"/>
      <Setter Property="FlowDirection" Value="LeftToRight"/>
      <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}"/>
    </Style>
    <!-- Colored ping badge (v0.4.3): same levels as the Tunnels page — green <300, amber <800, red slow/failed. -->
    <Style x:Key="PingBadge" TargetType="Border">
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="8,2"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Visibility" Value="Collapsed"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding PingLevel}" Value="1"><Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}"/><Setter Property="Visibility" Value="Visible"/></DataTrigger>
        <DataTrigger Binding="{Binding PingLevel}" Value="2"><Setter Property="Background" Value="{DynamicResource WarningSoftBrush}"/><Setter Property="Visibility" Value="Visible"/></DataTrigger>
        <DataTrigger Binding="{Binding PingLevel}" Value="3"><Setter Property="Background" Value="{DynamicResource WarningSoftBrush}"/><Setter Property="Visibility" Value="Visible"/></DataTrigger>
        <DataTrigger Binding="{Binding PingLevel}" Value="4"><Setter Property="Background" Value="{DynamicResource DangerSoftBrush}"/><Setter Property="Visibility" Value="Visible"/></DataTrigger>
        <DataTrigger Binding="{Binding PingLevel}" Value="5"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter Property="Visibility" Value="Visible"/></DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="PingBadgeText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontFamily" Value="{StaticResource LatinFont}"/>
      <Setter Property="FlowDirection" Value="LeftToRight"/>
      <Setter Property="TextWrapping" Value="NoWrap"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding PingLevel}" Value="1"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/></DataTrigger>
        <DataTrigger Binding="{Binding PingLevel}" Value="2"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/></DataTrigger>
        <DataTrigger Binding="{Binding PingLevel}" Value="3"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/></DataTrigger>
        <DataTrigger Binding="{Binding PingLevel}" Value="4"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/></DataTrigger>
        <DataTrigger Binding="{Binding PingLevel}" Value="5"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></DataTrigger>
      </Style.Triggers>
    </Style>
    <!-- Quick switch tile (v0.4.3). -->
    <Style x:Key="QuickTile" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource ControlBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="13,10"/>
      <Setter Property="Margin" Value="0,0,10,0"/>
    </Style>
  </UserControl.Resources>
  <Grid>
  <!-- v0.4.38 - the live background: particles + soft waves that wake up when the tunnel connects -->
  <c:LiveBackdrop IsLive="{Binding IsConnected}"/>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel x:Name="Cards">
      <TextBlock Text="{l:T Dash.Title}" Style="{StaticResource Title}"/>
      <TextBlock Text="{l:T Dash.Subtitle}" Style="{StaticResource Subtitle}"/>

      <Border Style="{StaticResource FlatCard}" Background="{DynamicResource WarningSoftBrush}" BorderBrush="{DynamicResource WarningBrush}" Padding="14,10" Visibility="{Binding HasRecovery, Converter={StaticResource BoolToVis}}">
        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" Foreground="{DynamicResource WarningBrush}" Margin="0,0,10,0"/><TextBlock Text="{l:T Dash.RecoveryBanner}"/></StackPanel>
      </Border>

      <!-- Hero: orb + clear status -->
      <Border Style="{StaticResource Card}" Padding="26,22">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel>
            <c:ConnectOrb State="{Binding State}" Command="{Binding ConnectCommand}" Label="{Binding OrbLabel}"/>
            <TextBlock Text="{Binding OrbHint}" Style="{StaticResource Subtle}" HorizontalAlignment="Center" Margin="0,-6,0,0"/>
            <!-- Rescue (v0.4.3): no dead ends in the error/degraded state — one click retries with the fastest profile. -->
            <Button Command="{Binding RescueCommand}" HorizontalAlignment="Center" Margin="0,10,0,0" Padding="14,7">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding State}" Value="Error"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                    <DataTrigger Binding="{Binding State}" Value="Degraded"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/>
                <TextBlock Text="{l:T Dash.Rescue}" FontSize="12.5" FontWeight="SemiBold"/>
              </StackPanel>
            </Button>
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="26,6,0,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding HeroTitle}" FontFamily="{DynamicResource DisplayFont}" FontSize="30" FontWeight="Bold"/>
            <TextBlock Text="{Binding HeroText}" Style="{StaticResource Subtle}" FontSize="13.5" Margin="0,4,0,14"/>

            <WrapPanel Margin="0,0,0,12">
              <Border Style="{StaticResource Pill}" Background="{DynamicResource SuccessSoftBrush}" Margin="0,0,8,6" Visibility="{Binding EgressVerified, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="11" Foreground="{DynamicResource SuccessBrush}"/>
                  <TextBlock Text="{l:T Dash.IpVerified}" Margin="6,0,0,0" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}"/></StackPanel>
              </Border>
              <Border Style="{StaticResource Pill}" Margin="0,0,8,6" Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE916;" Style="{StaticResource Icon}" FontSize="11"/>
                  <TextBlock Text="{Binding Uptime}" Margin="6,0,0,0" FontSize="12" FontWeight="SemiBold" Style="{StaticResource Latin}"/></StackPanel>
              </Border>
              <!-- Country + flag of the tunnel exit (v0.4.6) — appears the moment the geo lookup answers. -->
              <Border Style="{StaticResource Pill}" Margin="0,0,8,6" Visibility="{Binding HasTunnelGeo, Converter={StaticResource BoolToVis}}" ToolTip="{Binding TunnelGeoText}">
                <StackPanel Orientation="Horizontal">
                  <c:FlagBox Code="{Binding TunnelGeo.Code}" Country="{Binding TunnelGeo.Country}" Width="26" Height="18"/>
                  <TextBlock Text="{Binding TunnelGeoText}" Margin="7,0,0,0" FontSize="12" FontWeight="SemiBold"/>
                </StackPanel>
              </Border>
              <!-- Split summary pill is now a button (v0.4.3): click opens the split-tunneling page. -->
              <Button Command="{Binding OpenSplitCommand}" ToolTip="{l:T Dash.OpenSplitTip}" Margin="0,0,8,6" Padding="12,4">
                <Button.Style>
                  <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                  </Style>
                </Button.Style>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding SplitSummary}" FontSize="12"/>
                  <TextBlock Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="10" Margin="8,0,0,0" Foreground="{DynamicResource SubtleTextBrush}"/>
                </StackPanel>
              </Button>
            </WrapPanel>

            <DockPanel Margin="0,0,0,8">
              <!-- v0.4.20 (user: «سرور انتخاب میکنیم تست بتونیم بگیریم ازش»): test ONLY the selected card. -->
              <Button DockPanel.Dock="Right" Command="{Binding TestSelectedPingCommand}" Margin="0,0,8,0" Padding="10,6" ToolTip="{l:T Dash.TestSelectedTip}">
                <Button.Style>
                  <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                    <Setter Property="Content">
                      <Setter.Value>
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE770;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,7,0"/><TextBlock Text="{l:T Dash.TestSelected}" FontSize="12" FontWeight="SemiBold"/></StackPanel>
                      </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsPinging}" Value="True">
                        <Setter Property="IsEnabled" Value="False"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Button.Style>
              </Button>
              <Button DockPanel.Dock="Right" Command="{Binding TestPingCommand}" Margin="0" Padding="12,6">
                <Button.Style>
                  <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                    <Setter Property="Content">
                      <Setter.Value>
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xEC05;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,7,0"/><TextBlock Text="{l:T Dash.TestPing}" FontSize="12" FontWeight="SemiBold"/></StackPanel>
                      </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsPinging}" Value="True">
                        <Setter Property="Content">
                          <Setter.Value>
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9CE;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,7,0"/><TextBlock Text="{l:T Dash.TestingPings}" FontSize="12" FontWeight="SemiBold"/></StackPanel>
                          </Setter.Value>
                        </Setter>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Button.Style>
              </Button>
              <!-- v0.4.19 (user: «تو قسمت صفحه اصلی هم یک قسمت sort بزار که بشه طبقه بندی کرد»):
                   order the server cards — manual drag order, ping, name, engine type or protocol. -->
              <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SortMode}" MinWidth="132" Margin="0,0,8,8" VerticalAlignment="Center"
                        ToolTip="{l:T Dash.SortTip}">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="&#xE8CB;" Style="{StaticResource Icon}" FontSize="11" Margin="0,1,7,0" Foreground="{DynamicResource SubtleTextBrush}"/>
                      <TextBlock TextWrapping="NoWrap">
                        <TextBlock.Text>
                          <MultiBinding Converter="{x:Static l:LocMulti.Instance}" ConverterParameter="Dash.Sort">
                            <Binding/><Binding Path="Language" Source="{x:Static l:Loc.I}"/>
                          </MultiBinding>
                        </TextBlock.Text>
                      </TextBlock>
                    </StackPanel>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{l:T Dash.Profile}" Style="{StaticResource Subtle}"/>
                <TextBlock Text="{l:T Dash.Servers}" Style="{StaticResource Subtle}" FontSize="10.5"/>
              </StackPanel>
            </DockPanel>

            <!-- v0.4.20 (user: «اون گروه که درست میکنیم هم لاقل باس تو داشبورد بیاد دیگه»): group chips above the
                 server cards — «همه» + every group, live counts; a subscription group carries a dot marker and its
                 click opens the account info strip (volume + expiry + engine) right below. -->
            <ItemsControl ItemsSource="{Binding Groups}" Margin="0,0,0,8">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Command="{Binding DataContext.PickGroupCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" CommandParameter="{Binding}"
                          Cursor="Hand" Margin="0,0,6,6" Padding="11,4" Focusable="False">
                    <Button.Style>
                      <Style TargetType="Button">
                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                          <Setter.Value>
                            <ControlTemplate TargetType="Button">
                              <Border x:Name="b" CornerRadius="8" Background="{DynamicResource ControlBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center"/>
                              </Border>
                              <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                  <Setter TargetName="b" Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
                                  <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource StrongBorderBrush}"/>
                                </Trigger>
                                <DataTrigger Binding="{Binding IsSelectedChip}" Value="True">
                                  <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                  <Setter TargetName="b" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                </DataTrigger>
                              </ControlTemplate.Triggers>
                            </ControlTemplate>
                          </Setter.Value>
                        </Setter>
                      </Style>
                    </Button.Style>
                    <Button.Content>
                      <StackPanel Orientation="Horizontal">
                        <!-- subscription marker dot (v0.4.20) — shown only on subscription groups -->
                        <Border Width="6" Height="6" CornerRadius="2" Background="{DynamicResource AccentBrush}" Margin="0,0,7,0" VerticalAlignment="Center">
                          <Border.Style>
                            <Style TargetType="Border">
                              <Setter Property="Visibility" Value="Collapsed"/>
                              <Style.Triggers><DataTrigger Binding="{Binding IsSub}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                            </Style>
                          </Border.Style>
                        </Border>
                        <TextBlock Text="{l:T Profiles.GroupAll}" VerticalAlignment="Center">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Setter Property="Visibility" Value="Collapsed"/>
                              <Style.Triggers><DataTrigger Binding="{Binding IsAll}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding Tag}" FontWeight="SemiBold" VerticalAlignment="Center">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Setter Property="Visibility" Value="Collapsed"/>
                              <Style.Triggers><DataTrigger Binding="{Binding IsAll}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                        <Border CornerRadius="6" Background="{DynamicResource AccentSoftBrush}" Padding="6,1" Margin="7,0,0,0">
                          <TextBlock Text="{Binding Count}" FontSize="10.5" Foreground="{DynamicResource AccentBrush}" FontFamily="{StaticResource LatinFont}"/>
                        </Border>
                      </StackPanel>
                    </Button.Content>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- v0.4.20: the subscription account info strip — panel-reported volume bar + expiry + engine,
                 shown while a subscription group chip is selected («اگه لینک سابه همون مقدار حجم و زمان و این چیزاشو بزنه»). -->
            <Border Visibility="{Binding GroupInfoVisible, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8" Padding="12,9" CornerRadius="10"
                    Background="{DynamicResource ControlBrush}" BorderThickness="1">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                  <Style.Triggers><DataTrigger Binding="{Binding GroupIsDead}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/></DataTrigger></Style.Triggers>
                </Style>
              </Border.Style>
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE7F4;" Style="{StaticResource Icon}" FontSize="14" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding SelectedGroup.Tag}" FontWeight="Bold" Margin="9,0,0,0" VerticalAlignment="Center"/>
                  <!-- engine chip -->
                  <Border Style="{StaticResource Pill}" Padding="8,1" Margin="10,0,0,0" Background="{DynamicResource AccentSoftBrush}" Visibility="{Binding GroupEngineText, Converter={StaticResource NullToCollapsed}}">
                    <TextBlock Text="{Binding GroupEngineText}" FontSize="10.5" Foreground="{DynamicResource AccentBrush}" FontFamily="{StaticResource LatinFont}"/>
                  </Border>
                </StackPanel>
                <Grid Margin="0,8,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="{l:T Sub.VolumeLabel}" Style="{StaticResource Subtle}" FontSize="10.5"/>
                    <Grid Margin="0,4,0,0">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <ProgressBar Height="6" BorderThickness="0" Value="{Binding GroupVolumePct}" Maximum="100" VerticalAlignment="Center" c:Fx.Equalize="True">
                        <ProgressBar.Style>
                          <Style TargetType="ProgressBar">
                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding GroupVolumeWarn}" Value="True"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/></DataTrigger>
                              <DataTrigger Binding="{Binding GroupVolumeDead}" Value="True"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/></DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </ProgressBar.Style>
                      </ProgressBar>
                      <TextBlock Grid.Column="1" Text="{Binding GroupVolumeText}" Margin="10,0,0,0" VerticalAlignment="Center" FontFamily="{StaticResource LatinFont}" FlowDirection="LeftToRight" FontWeight="SemiBold" FontSize="12">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding GroupVolumeWarn}" Value="True"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/></DataTrigger>
                              <DataTrigger Binding="{Binding GroupVolumeDead}" Value="True"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/></DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </Grid>
                  </StackPanel>
                  <!-- expiry chip -->
                  <Border Grid.Column="1" CornerRadius="8" Padding="10,4" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding GroupExpireWarn}" Value="True"><Setter Property="Background" Value="{DynamicResource WarningSoftBrush}"/></DataTrigger>
                          <DataTrigger Binding="{Binding GroupExpireDead}" Value="True"><Setter Property="Background" Value="{DynamicResource DangerSoftBrush}"/></DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="&#xE823;" FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding GroupExpireWarn}" Value="True"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/></DataTrigger>
                              <DataTrigger Binding="{Binding GroupExpireDead}" Value="True"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/></DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                      <TextBlock Text="{Binding GroupExpireText}" Margin="6,0,0,0" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Border>
                </Grid>
              </StackPanel>
            </Border>

            <!-- Server cards: fastest first, colored ping, star for the best profile (v0.4.3). -->
            <ScrollViewer MaxHeight="270" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding Profiles}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Style="{StaticResource ServerCard}"
                            Command="{Binding DataContext.SelectProfileCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                            CommandParameter="{Binding}">
                      <!-- Card body is fixed LTR: profile names are Latin, so segments never reorder and
                           "602 ms" reads correctly in BOTH languages; the WrapPanel still flows RTL (v0.4.3). -->
                      <StackPanel FlowDirection="LeftToRight">
                        <Grid>
                          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                          <!-- v0.4.38: a big country flag when the name tells us the country, else the engine glyph tile -->
                          <Grid VerticalAlignment="Center">
                            <Border x:Name="glyphBox" Width="34" Height="34" CornerRadius="{DynamicResource ControlRadius}" Background="{DynamicResource AccentSoftBrush}">
                              <TextBlock x:Name="glyph" Text="&#xE774;" Style="{StaticResource Icon}" FontSize="15" HorizontalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                            </Border>
                            <c:FlagBox x:Name="flag" Code="{Binding CountryCode}" Width="40" Height="28" Visibility="Collapsed"/>
                          </Grid>
                          <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="9,0,0,0" FontSize="12.5" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="WordEllipsis" VerticalAlignment="Center"/>
                          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                            <Border Style="{StaticResource PingBadge}">
                              <StackPanel Orientation="Horizontal">
                                <!-- v0.4.32: skeleton shimmer while the ping is being measured (instead of "…") -->
                                <c:Skeleton Width="30" Height="9" CornerRadius="4.5" Margin="0,2">
                                  <c:Skeleton.Style><Style TargetType="c:Skeleton"><Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding PingLevel}" Value="5"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                  </Style></c:Skeleton.Style>
                                </c:Skeleton>
                                <TextBlock Text="{Binding Ping}">
                                  <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource PingBadgeText}">
                                    <Style.Triggers><DataTrigger Binding="{Binding PingLevel}" Value="5"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                                  </Style></TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text=" ms" Margin="1,0,0,0">
                                  <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource PingBadgeText}">
                                    <Style.Triggers>
                                      <DataTrigger Binding="{Binding Ping}" Value="&#x2026;"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                      <DataTrigger Binding="{Binding Ping}" Value="&#xD7;"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                      <DataTrigger Binding="{Binding Ping}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                      <DataTrigger Binding="{Binding PingLevel}" Value="5"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                    </Style.Triggers>
                                  </Style></TextBlock.Style>
                                </TextBlock>
                              </StackPanel>
                            </Border>
                            <TextBlock Text="&#xE735;" FontFamily="{StaticResource IconFont}" FontSize="13" Margin="7,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource WarningBrush}" ToolTip="{l:T Dash.Best}">
                              <TextBlock.Style><Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers><DataTrigger Binding="{Binding IsBest}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                              </Style></TextBlock.Style>
                            </TextBlock>
                          </StackPanel>
                        </Grid>
                        <StackPanel x:Name="chips" Orientation="Horizontal" Margin="49,7,0,0">
                          <Border Style="{StaticResource ProtoChip}">
                            <TextBlock Text="{Binding Source}" Style="{StaticResource ProtoChipText}"/>
                          </Border>
                          <Border Style="{StaticResource EngineChip}">
                            <TextBlock Text="{Binding Engine}" Style="{StaticResource EngineChipText}"/>
                          </Border>
                        </StackPanel>
                        <!-- Auto card body (v0.4.6): the strategy line instead of protocol chips. -->
                        <StackPanel x:Name="autoSub" Orientation="Vertical" Margin="49,6,4,0" Visibility="Collapsed">
                          <TextBlock Text="{Binding AutoSub}" FontSize="10.8" Foreground="{DynamicResource SubtleTextBrush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding AutoSub}"/>
                        </StackPanel>
                        <!-- v0.4.38: quality bar - green (good) / yellow (ok) / red (slow or failed); length = quality -->
                        <Grid x:Name="quality" Height="4" Margin="0,9,0,0">
                          <Border CornerRadius="2" Background="{DynamicResource BorderBrush}"/>
                          <Border x:Name="qFill" CornerRadius="2" HorizontalAlignment="Stretch" Background="{DynamicResource SubtleTextBrush}" RenderTransformOrigin="0,0.5">
                            <Border.RenderTransform><ScaleTransform ScaleX="0"/></Border.RenderTransform>
                          </Border>
                        </Grid>
                      </StackPanel>
                    </Button>
                    <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding HasCountry}" Value="True">
                        <Setter TargetName="flag" Property="Visibility" Value="Visible"/>
                        <Setter TargetName="glyphBox" Property="Visibility" Value="Collapsed"/>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding PingLevel}" Value="0">
                        <Setter TargetName="qFill" Property="Background" Value="{DynamicResource SubtleTextBrush}"/>
                        <DataTrigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="qFill" Storyboard.TargetProperty="RenderTransform.ScaleX" To="0" Duration="0:0:0.45"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></DataTrigger.EnterActions>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding PingLevel}" Value="1">
                        <Setter TargetName="qFill" Property="Background" Value="{DynamicResource SuccessBrush}"/>
                        <DataTrigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="qFill" Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.45"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></DataTrigger.EnterActions>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding PingLevel}" Value="2">
                        <Setter TargetName="qFill" Property="Background" Value="{DynamicResource WarningBrush}"/>
                        <DataTrigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="qFill" Storyboard.TargetProperty="RenderTransform.ScaleX" To="0.6" Duration="0:0:0.45"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></DataTrigger.EnterActions>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding PingLevel}" Value="3">
                        <Setter TargetName="qFill" Property="Background" Value="{DynamicResource DangerBrush}"/>
                        <DataTrigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="qFill" Storyboard.TargetProperty="RenderTransform.ScaleX" To="0.3" Duration="0:0:0.45"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></DataTrigger.EnterActions>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding PingLevel}" Value="4">
                        <Setter TargetName="qFill" Property="Background" Value="{DynamicResource DangerBrush}"/>
                        <DataTrigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="qFill" Storyboard.TargetProperty="RenderTransform.ScaleX" To="0.08" Duration="0:0:0.45"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></DataTrigger.EnterActions>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding PingLevel}" Value="5">
                        <Setter TargetName="qFill" Property="Background" Value="{DynamicResource AccentBrush}"/>
                        <DataTrigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="qFill" Storyboard.TargetProperty="RenderTransform.ScaleX" From="0" To="1" Duration="0:0:0.9" AutoReverse="True" RepeatBehavior="Forever"/></Storyboard></BeginStoryboard></DataTrigger.EnterActions>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding Engine}" Value="WireGuard"><Setter TargetName="glyph" Property="Text" Value="&#xE72E;"/></DataTrigger>
                      <DataTrigger Binding="{Binding Engine}" Value="Xray"><Setter TargetName="glyph" Property="Text" Value="&#xE945;"/></DataTrigger>
                      <DataTrigger Binding="{Binding Engine}" Value="OpenVpn"><Setter TargetName="glyph" Property="Text" Value="&#xE753;"/></DataTrigger>
                      <DataTrigger Binding="{Binding IsAuto}" Value="True">
                        <Setter TargetName="glyph" Property="Text" Value="&#xEC4A;"/>
                        <Setter TargetName="chips" Property="Visibility" Value="Collapsed"/>
                        <Setter TargetName="autoSub" Property="Visibility" Value="Visible"/>
                        <Setter TargetName="quality" Property="Visibility" Value="Collapsed"/>
                      </DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>

            <!-- v0.4.23 (user: «تو داشبورد کاش کاری کنی که wasd کار کنه و روی سرورا بشه جا به جا شد»):
                 a one-line hint so the keyboard navigation is discoverable. -->
            <TextBlock Text="{l:T Dash.WasdHint}" Style="{StaticResource Subtle}" FontSize="11" Margin="2,6,0,0"/>

            <!-- v0.4.23 (suggestion #6, user: «نقشهٔ جغرافیایی سرورها — یک نگاه کلی روی موقعیت‌ها»):
                 the whole fleet grouped by country, flags included, best measured ping per country. -->
            <Border Style="{StaticResource Card}" Margin="0,10,0,0" Visibility="{Binding HasCountryRows, Converter={StaticResource BoolToVis}}">
              <StackPanel>
                <DockPanel Margin="0,0,0,8">
                  <TextBlock DockPanel.Dock="Right" Text="{l:T Dash.ServerMapHint}" Style="{StaticResource Subtle}" FontSize="11" VerticalAlignment="Center" TextWrapping="NoWrap"/>
                  <TextBlock Text="{l:T Dash.ServerMap}" Style="{StaticResource CardTitle}" c:CardFold.Key="map" Margin="0" VerticalAlignment="Center"/>
                </DockPanel>
                <ItemsControl ItemsSource="{Binding CountryRows}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border CornerRadius="11" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="11,8" Margin="0,0,8,8" ToolTip="{Binding Title}">
                        <StackPanel Orientation="Horizontal">
                          <c:FlagBox Code="{Binding Code}" Width="30" Height="21" VerticalAlignment="Center"/>
                          <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12.5" TextWrapping="NoWrap"/>
                            <StackPanel Orientation="Horizontal">
                              <TextBlock Text="{Binding CountText}" FontSize="11" Style="{StaticResource Subtle}" TextWrapping="NoWrap"/>
                              <TextBlock Text="{Binding Best}" FontSize="11" Foreground="{DynamicResource SuccessBrush}" Margin="7,0,0,0" VerticalAlignment="Center" FontFamily="{StaticResource LatinFont}" FlowDirection="LeftToRight" TextWrapping="NoWrap"/>
                            </StackPanel>
                          </StackPanel>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>

            <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource DangerBrush}" Margin="0,6,0,0"/>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
              <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding IsAdmin}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
              <TextBlock Text="&#xE7EF;" Style="{StaticResource Icon}" Foreground="{DynamicResource WarningBrush}" Margin="0,0,8,0"/>
              <TextBlock Text="{l:T Admin.NotElevated}" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" MaxWidth="460"/>
              <!-- v0.4.22 (user: «زیر اون هشداری که برای تونل کردن میگه ... یک گزینه بزار که بزنن روش خود اپ بسته شه و
                   حالت ادمین باز شه»): one click — the app relaunches itself elevated (UAC prompt, old instance exits). -->
              <Button Command="{Binding RestartAdminCommand}" Style="{StaticResource AccentButton}" Padding="14,5" Margin="12,0,0,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE7EF;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,7,0"/>
                  <TextBlock Text="{l:T Admin.RestartButton}" TextWrapping="NoWrap"/>
                </StackPanel>
              </Button>
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Quick switches (v0.4.3): the four settings users should not have to hunt for across pages. -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="{l:T Dash.Quick}" Style="{StaticResource CardTitle}" c:CardFold.Key="quick"/>
          <UniformGrid Columns="4">
            <Border Style="{StaticResource QuickTile}">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="{l:T Quick.SystemProxy}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                  <TextBlock Text="{l:T Quick.SystemProxySub}" Style="{StaticResource Subtle}" FontSize="10.5" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                </StackPanel>
                <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding QuickSystemProxy}" VerticalAlignment="Center" Margin="8,0,0,0"/>
              </Grid>
            </Border>
            <Border Style="{StaticResource QuickTile}">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="{l:T Quick.KillSwitch}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                  <TextBlock Text="{l:T Quick.KillSwitchSub}" Style="{StaticResource Subtle}" FontSize="10.5" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                </StackPanel>
                <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding QuickKillSwitch}" VerticalAlignment="Center" Margin="8,0,0,0"/>
              </Grid>
            </Border>
            <Border Style="{StaticResource QuickTile}">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="{l:T Quick.IranDirect}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                  <TextBlock Text="{l:T Quick.IranDirectSub}" Style="{StaticResource Subtle}" FontSize="10.5" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                </StackPanel>
                <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding QuickIranDirect}" VerticalAlignment="Center" Margin="8,0,0,0"/>
              </Grid>
            </Border>
            <Border Style="{StaticResource QuickTile}">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="{l:T Quick.GameMode}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                  <TextBlock Text="{l:T Quick.GameModeSub}" Style="{StaticResource Subtle}" FontSize="10.5" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                </StackPanel>
                <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding QuickGameMode}" VerticalAlignment="Center" Margin="8,0,0,0"/>
              </Grid>
            </Border>
          </UniformGrid>
        </StackPanel>
      </Border>

      <UniformGrid Columns="4">
        <Border Style="{StaticResource Card}"><StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,8"><Border Width="30" Height="30" CornerRadius="9" Background="{DynamicResource AccentSoftBrush}"><TextBlock Text="&#xEC05;" Style="{StaticResource Icon}" HorizontalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/></Border>
            <TextBlock Text="{l:T Dash.Latency}" Style="{StaticResource Subtle}" VerticalAlignment="Center" Margin="10,0,0,0"/></StackPanel>
          <TextBlock Text="{Binding Latency}" Style="{StaticResource Metric}"/></StackPanel></Border>
        <Border Style="{StaticResource Card}"><StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,8"><Border Width="30" Height="30" CornerRadius="9" Background="{DynamicResource SuccessSoftBrush}"><TextBlock Text="&#xE896;" Style="{StaticResource Icon}" HorizontalAlignment="Center" Foreground="{DynamicResource SuccessBrush}"/></Border>
            <TextBlock Text="{l:T Dash.Download}" Style="{StaticResource Subtle}" VerticalAlignment="Center" Margin="10,0,0,0"/></StackPanel>
          <TextBlock Text="{Binding Download}" Style="{StaticResource Metric}" FlowDirection="LeftToRight" HorizontalAlignment="Left"/></StackPanel></Border>
        <Border Style="{StaticResource Card}"><StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,8"><Border Width="30" Height="30" CornerRadius="9" Background="{DynamicResource WarningSoftBrush}"><TextBlock Text="&#xE898;" Style="{StaticResource Icon}" HorizontalAlignment="Center" Foreground="{DynamicResource WarningBrush}"/></Border>
            <TextBlock Text="{l:T Dash.Upload}" Style="{StaticResource Subtle}" VerticalAlignment="Center" Margin="10,0,0,0"/></StackPanel>
          <TextBlock Text="{Binding Upload}" Style="{StaticResource Metric}" FlowDirection="LeftToRight" HorizontalAlignment="Left"/></StackPanel></Border>
        <Border Style="{StaticResource Card}"><StackPanel>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,8"><Border Width="30" Height="30" CornerRadius="9" Background="{DynamicResource AccentSoftBrush}"><TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" HorizontalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/></Border>
            <TextBlock Text="{l:T Dash.TunnelIp}" Style="{StaticResource Subtle}" VerticalAlignment="Center" Margin="10,0,0,0"/></StackPanel>
          <TextBlock Text="{Binding TunnelIp}" Style="{StaticResource Metric}" FontSize="19" FontFamily="{StaticResource LatinFont}" FlowDirection="LeftToRight" HorizontalAlignment="Left" Margin="0,5,0,0"/></StackPanel></Border>
      </UniformGrid>

      <!-- Live speed chart (v0.4.3): the app's "alive" feeling — two lines refreshed every second from the Clash /traffic stream. -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <DockPanel Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <Border Width="8" Height="8" CornerRadius="3" Background="{DynamicResource SuccessBrush}" VerticalAlignment="Center"/>
              <TextBlock Text="{l:T Dash.DownLegend}" Margin="6,0,14,0" FontSize="11.5" VerticalAlignment="Center"/>
              <Border Width="8" Height="8" CornerRadius="3" Background="{DynamicResource WarningBrush}" VerticalAlignment="Center"/>
              <TextBlock Text="{l:T Dash.UpLegend}" Margin="6,0,0,0" FontSize="11.5" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding SessionTraffic}" FontSize="11" Margin="18,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource SubtleTextBrush}" TextWrapping="NoWrap">
                <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                  <Setter Property="Visibility" Value="Visible"/>
                  <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
                </Style></TextBlock.Style>
              </TextBlock>
              <!-- Today / this-week usage from the recorded sessions (v0.4.11). -->
              <TextBlock Text="{Binding UsageSummary}" FontSize="11" Margin="14,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource SubtleTextBrush}" TextWrapping="NoWrap">
                <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                  <Setter Property="Visibility" Value="Visible"/>
                  <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
                </Style></TextBlock.Style>
              </TextBlock>
            </StackPanel>
            <TextBlock Text="{l:T Dash.SpeedChart}" Style="{StaticResource CardTitle}" c:CardFold.Key="speed" Margin="0" VerticalAlignment="Center"/>
          </DockPanel>
          <c:SpeedChart Down="{Binding DownHistory}" Up="{Binding UpHistory}" DownStroke="{DynamicResource SuccessBrush}" UpStroke="{DynamicResource WarningBrush}" Height="150"/>
        </StackPanel>
      </Border>

      <!-- Per-app usage (v0.4.12): which application consumed how much of the tunnel session.
           Live from sing-box's Clash /connections per-process counters; honest note when the engine can't provide it. -->
      <Border Style="{StaticResource Card}" Visibility="{Binding HasAppUsage, Converter={StaticResource BoolToVis}}">
        <StackPanel>
          <DockPanel Margin="0,0,0,8">
            <TextBlock DockPanel.Dock="Right" Text="{Binding AppUsageNote}" FontSize="11" VerticalAlignment="Center" TextWrapping="NoWrap">
              <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Subtle}">
                <Setter Property="Visibility" Value="Visible"/>
                <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
              </Style></TextBlock.Style>
            </TextBlock>
            <TextBlock Text="{l:T Dash.PerAppUsage}" Style="{StaticResource CardTitle}" c:CardFold.Key="apps" Margin="0" VerticalAlignment="Center"/>
          </DockPanel>
          <ItemsControl ItemsSource="{Binding AppUsage}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,3" ToolTip="{Binding Detail}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="76"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center" FlowDirection="LeftToRight"/>
                  <ProgressBar Grid.Column="1" Maximum="1" Value="{Binding BarWidth}" Height="7" Margin="10,0" VerticalAlignment="Center" c:Fx.AnimateProgress="True" c:Fx.Equalize="True"/>
                  <TextBlock Grid.Column="2" Text="{Binding Total}" FontSize="11.5" Style="{StaticResource Latin}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{l:T Dash.PerAppUsageHint}" FontSize="11" Margin="0,6,0,0">
            <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Subtle}">
              <Setter Property="Visibility" Value="Visible"/>
              <Style.Triggers><DataTrigger Binding="{Binding AppUsage.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
            </Style></TextBlock.Style>
          </TextBlock>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="{l:T Dash.LatencyChart}" Style="{StaticResource CardTitle}" c:CardFold.Key="latency"/>
          <c:Sparkline Values="{Binding LatencyHistory}" Height="120" Stroke="{DynamicResource AccentGradientBrush}" FlowDirection="LeftToRight"/>
        </StackPanel>
      </Border>

      <!-- Persistent usage statistics (v0.4.15): totals for today / 3 days / this week / this month / all time
           from the recorded sessions, plus per-app totals for the selected period (persisted in the database,
           survives restarts — unlike the live per-app card above which shows only the running session). -->
      <Border Style="{StaticResource Card}" x:Name="UsageCard">
        <Border.Resources>
          <Style x:Key="PeriodItem" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <Border x:Name="pill" CornerRadius="9" Padding="13,5" Margin="0,0,8,8" Background="{DynamicResource ControlBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <ContentPresenter/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="pill" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
                    <Trigger Property="IsSelected" Value="True">
                      <Setter TargetName="pill" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                      <Setter TargetName="pill" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </Border.Resources>
        <StackPanel>
          <DockPanel Margin="0,0,0,8">
            <Border DockPanel.Dock="Right" CornerRadius="8" Padding="10,3" VerticalAlignment="Center" Background="{DynamicResource AccentSoftBrush}">
              <Border.Style><Style TargetType="Border">
                <Setter Property="Visibility" Value="Visible"/>
                <Style.Triggers><DataTrigger Binding="{Binding UsageTotals}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
              </Style></Border.Style>
              <TextBlock Text="{Binding UsageTotals}" FontSize="11.5" FontWeight="SemiBold" Style="{StaticResource Latin}" TextWrapping="NoWrap"/>
            </Border>
            <TextBlock Text="{l:T Usage.Title}" Style="{StaticResource CardTitle}" c:CardFold.Key="usage" Margin="0" VerticalAlignment="Center"/>
          </DockPanel>
          <ListBox ItemsSource="{Binding UsagePeriods}" SelectedItem="{Binding UsagePeriod}" ItemContainerStyle="{StaticResource PeriodItem}" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,4">
            <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock FontSize="12" FontWeight="SemiBold" TextWrapping="NoWrap">
                  <TextBlock.Text><MultiBinding Converter="{x:Static l:LocMulti.Instance}" ConverterParameter="Usage"><Binding/><Binding Path="Language" Source="{x:Static l:Loc.I}"/></MultiBinding></TextBlock.Text>
                </TextBlock>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <ItemsControl ItemsSource="{Binding HistoryAppUsage}" MaxHeight="230">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,3" ToolTip="{Binding Detail}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="76"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center" FlowDirection="LeftToRight"/>
                  <ProgressBar Grid.Column="1" Maximum="1" Value="{Binding BarWidth}" Height="7" Margin="10,0" VerticalAlignment="Center" c:Fx.AnimateProgress="True" c:Fx.Equalize="True"/>
                  <TextBlock Grid.Column="2" Text="{Binding Total}" FontSize="11.5" Style="{StaticResource Latin}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{Binding UsageCardNote}" Style="{StaticResource Subtle}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
          <TextBlock Text="{l:T Usage.Hint}" Style="{StaticResource Subtle}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <DockPanel Margin="0,0,0,6">
            <Button DockPanel.Dock="Right" Content="{l:T Common.Refresh}" Command="{Binding RefreshIpsCommand}" Margin="0"/>
            <TextBlock Text="{l:T Dash.Egress}" Style="{StaticResource CardTitle}" c:CardFold.Key="egress" VerticalAlignment="Center"/>
          </DockPanel>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="1.4*"/></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="{l:T Dash.DirectIp}" Style="{StaticResource Subtle}"/><TextBlock Text="{Binding DirectIp}" FontWeight="SemiBold" FontSize="15" Style="{StaticResource Latin}" HorizontalAlignment="Left"/>
              <!-- Country + flag of the ISP IP (v0.4.6). -->
              <StackPanel Orientation="Horizontal" Margin="0,7,0,0" Visibility="{Binding HasDirectGeo, Converter={StaticResource BoolToVis}}">
                <c:FlagBox Code="{Binding DirectGeo.Code}" Country="{Binding DirectGeo.Country}"/>
                <TextBlock Text="{Binding DirectGeoText}" Margin="8,0,0,0" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
              </StackPanel>
            </StackPanel>
            <TextBlock Grid.Column="1" Text="&#xE72A;" Style="{StaticResource Icon}" FontSize="18" Margin="18,0" Foreground="{DynamicResource AccentBrush}"/>
            <StackPanel Grid.Column="2">
              <TextBlock Text="{l:T Dash.TunnelIp}" Style="{StaticResource Subtle}"/><TextBlock Text="{Binding TunnelIp}" FontWeight="SemiBold" FontSize="15" Style="{StaticResource Latin}" HorizontalAlignment="Left"/>
              <!-- Country + flag of the tunnel exit (v0.4.6) — filled once the lookup through the tunnel answers. -->
              <StackPanel Orientation="Horizontal" Margin="0,7,0,0" Visibility="{Binding HasTunnelGeo, Converter={StaticResource BoolToVis}}">
                <c:FlagBox Code="{Binding TunnelGeo.Code}" Country="{Binding TunnelGeo.Country}"/>
                <TextBlock Text="{Binding TunnelGeoText}" Margin="8,0,0,0" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
              </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="3"><TextBlock Text="{l:T Dash.Verdict}" Style="{StaticResource Subtle}"/>
              <TextBlock FontWeight="SemiBold"><TextBlock.Text><MultiBinding Converter="{x:Static l:LocMulti.Instance}" ConverterParameter="Verdict"><Binding Path="EgressVerdict"/><Binding Path="Language" Source="{x:Static l:Loc.I}"/></MultiBinding></TextBlock.Text></TextBlock>
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="{l:T Dash.Conflicts}" Style="{StaticResource CardTitle}" c:CardFold.Key="conflicts"/>
          <ItemsControl ItemsSource="{Binding Conflicts}"><ItemsControl.ItemTemplate><DataTemplate>
            <Border CornerRadius="10" Background="{DynamicResource WarningSoftBrush}" Padding="12,8" Margin="0,0,0,6">
              <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" Foreground="{DynamicResource WarningBrush}" Margin="0,0,10,0"/><TextBlock Text="{Binding}"/></StackPanel>
            </Border>
          </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          <TextBlock Text="{l:T Dash.NoConflicts}" Style="{StaticResource Subtle}"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
  </Grid>
</UserControl>
