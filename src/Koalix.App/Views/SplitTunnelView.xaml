<UserControl x:Class="Koalix.App.Views.SplitTunnelView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:Koalix.App.Localization" xmlns:c="clr-namespace:Koalix.App.Controls">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
  <StackPanel>
    <TextBlock Text="{l:T Split.Title}" Style="{StaticResource Title}"/>
    <TextBlock Text="{l:T Split.Subtitle}" Style="{StaticResource Subtitle}"/>
    <Border Style="{StaticResource Card}">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="{l:T Split.ModeLabel}" Style="{StaticResource CardTitle}"/>
          <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}" HorizontalAlignment="Left" MinWidth="320">
            <ComboBox.ItemTemplate><DataTemplate><TextBlock TextWrapping="NoWrap"><TextBlock.Text><MultiBinding Converter="{x:Static l:LocMulti.Instance}" ConverterParameter="Split.Mode"><Binding /><Binding Path="Language" Source="{x:Static l:Loc.I}"/></MultiBinding></TextBlock.Text></TextBlock></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Style="{StaticResource Subtle}" Margin="0,2,0,0">
            <TextBlock.Text><MultiBinding Converter="{x:Static l:LocMulti.Instance}" ConverterParameter="Split.ModeHelp"><Binding Path="Mode"/><Binding Path="Language" Source="{x:Static l:Loc.I}"/></MultiBinding></TextBlock.Text>
          </TextBlock>
        </StackPanel>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" MinWidth="250" Margin="20,0,0,0">
          <CheckBox Style="{StaticResource Switch}" Content="{l:T Split.TunnelDns}" IsChecked="{Binding TunnelDns}"/>
          <CheckBox Style="{StaticResource Switch}" Content="{l:T Split.BlockIpv6}" IsChecked="{Binding BlockIpv6}"/>
          <CheckBox Style="{StaticResource Switch}" Content="{l:T Split.BlockQuic}" IsChecked="{Binding BlockQuic}" ToolTip="{l:T Split.BlockQuicHint}"/>
          <CheckBox Style="{StaticResource Switch}" Content="{l:T Split.IranDirect}" IsChecked="{Binding IranDirect}" ToolTip="{l:T Split.IranDirectHint}"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- v0.4.32: domain routing rules — these sites always tunnel / always go direct, whatever app opens them -->
    <Border Style="{StaticResource Card}">
      <StackPanel>
        <DockPanel>
          <TextBlock Text="{l:T Split.Domains.Title}" Style="{StaticResource CardTitle}"/>
          <TextBlock Text="{Binding DomainsSummary}" Style="{StaticResource Subtle}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </DockPanel>
        <TextBlock Text="{l:T Split.Domains.Hint}" Style="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="{l:T Split.Domains.Proxy}" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox Text="{Binding ProxyDomainsText}" AcceptsReturn="True" TextWrapping="NoWrap" FlowDirection="LeftToRight"
                     MinHeight="96" MaxHeight="180" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" FontFamily="Consolas"/>
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="{l:T Split.Domains.Direct}" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox Text="{Binding DirectDomainsText}" AcceptsReturn="True" TextWrapping="NoWrap" FlowDirection="LeftToRight"
                     MinHeight="96" MaxHeight="180" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" FontFamily="Consolas"/>
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>

    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="{l:T Split.Rules}" Style="{StaticResource CardTitle}"/>
          <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <ComboBox ItemsSource="{Binding Actions}" SelectedItem="{Binding NewAction}" MinWidth="130">
              <ComboBox.ItemTemplate><DataTemplate><TextBlock TextWrapping="NoWrap"><TextBlock.Text><MultiBinding Converter="{x:Static l:LocMulti.Instance}" ConverterParameter="Action"><Binding /><Binding Path="Language" Source="{x:Static l:Loc.I}"/></MultiBinding></TextBlock.Text></TextBlock></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
            <Button Command="{Binding BrowseCommand}" Style="{StaticResource AccentButton}">
              <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7AC;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/><TextBlock Text="{l:T Split.Browse}" TextWrapping="NoWrap"/></StackPanel>
            </Button>
            <Button Command="{Binding BrowseFolderCommand}" Style="{StaticResource AccentButton}">
              <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/><TextBlock Text="{l:T Split.BrowseFolder}" TextWrapping="NoWrap"/></StackPanel>
            </Button>
            <CheckBox Content="{l:T Split.IncludeFolder}" IsChecked="{Binding NewIncludeFolder}" VerticalAlignment="Center" Margin="4,0,0,8"/>
          </WrapPanel>
          <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Button Command="{Binding SetActionCommand}" CommandParameter="Tunnel"><StackPanel Orientation="Horizontal"><Border Width="8" Height="8" CornerRadius="3" Background="{DynamicResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="{l:T Action.Tunnel}"/></StackPanel></Button>
            <Button Command="{Binding SetActionCommand}" CommandParameter="Direct"><StackPanel Orientation="Horizontal"><Border Width="8" Height="8" CornerRadius="3" Background="{DynamicResource SuccessBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="{l:T Action.Direct}"/></StackPanel></Button>
            <Button Command="{Binding SetActionCommand}" CommandParameter="Block"><StackPanel Orientation="Horizontal"><Border Width="8" Height="8" CornerRadius="3" Background="{DynamicResource DangerBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="{l:T Action.Block}"/></StackPanel></Button>
            <Button Content="{l:T Split.ToggleFolder}" Command="{Binding ToggleFolderCommand}"/>
            <Button Content="{l:T Common.Delete}" Command="{Binding RemoveCommand}" Style="{StaticResource DangerButton}"/>
          </WrapPanel>
          <Grid>
            <ListBox ItemsSource="{Binding Rules}" SelectedItem="{Binding Selected}" Height="320" ScrollViewer.VerticalScrollBarVisibility="Auto">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <DockPanel>
                    <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="10" Background="{DynamicResource AccentSoftBrush}">
                      <TextBlock x:Name="glyph" Text="&#xE7AC;" Style="{StaticResource Icon}" FontSize="15" HorizontalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                    </Border>
                    <Border x:Name="action" DockPanel.Dock="Right" Style="{StaticResource Pill}" Background="{DynamicResource AccentSoftBrush}">
                      <TextBlock x:Name="actionText" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" TextWrapping="NoWrap">
                        <TextBlock.Text><MultiBinding Converter="{x:Static l:LocMulti.Instance}" ConverterParameter="Action"><Binding Path="Action"/><Binding Path="Language" Source="{x:Static l:Loc.I}"/></MultiBinding></TextBlock.Text>
                      </TextBlock>
                    </Border>
                    <StackPanel Margin="12,0" VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                        <Border x:Name="folderTag" Style="{StaticResource Pill}" Padding="7,0" Margin="8,0,0,0" Background="{DynamicResource ControlBrush}" Visibility="Collapsed">
                          <TextBlock Text="{l:T Split.WholeFolder}" FontSize="10.5" TextWrapping="NoWrap"/>
                        </Border>
                      </StackPanel>
                      <TextBlock Text="{Binding ExecutablePath}" FontSize="11" Foreground="{DynamicResource SubtleTextBrush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" FlowDirection="LeftToRight" HorizontalAlignment="Left" FontFamily="{StaticResource LatinFont}"/>
                    </StackPanel>
                  </DockPanel>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsFolderRule}" Value="True"><Setter TargetName="glyph" Property="Text" Value="&#xE8B7;"/></DataTrigger>
                    <DataTrigger Binding="{Binding IncludeFolder}" Value="True"><Setter TargetName="folderTag" Property="Visibility" Value="Visible"/></DataTrigger>
                    <DataTrigger Binding="{Binding Action}" Value="Direct"><Setter TargetName="action" Property="Background" Value="{DynamicResource SuccessSoftBrush}"/><Setter TargetName="actionText" Property="Foreground" Value="{DynamicResource SuccessBrush}"/></DataTrigger>
                    <DataTrigger Binding="{Binding Action}" Value="Block"><Setter TargetName="action" Property="Background" Value="{DynamicResource DangerSoftBrush}"/><Setter TargetName="actionText" Property="Foreground" Value="{DynamicResource DangerBrush}"/></DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
              <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers>
                <DataTrigger Binding="{Binding Rules.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
              <TextBlock Text="&#xE8B7;" Style="{StaticResource Icon}" FontSize="34" HorizontalAlignment="Center" Foreground="{DynamicResource SubtleTextBrush}" Opacity="0.6"/>
              <TextBlock Text="{l:T Split.Empty}" Style="{StaticResource Subtle}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,8,0,0" MaxWidth="320"/>
            </StackPanel>
          </Grid>
        </DockPanel>
      </Border>
      <Border Grid.Column="1" Style="{StaticResource Card}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="{l:T Split.RunningApps}" Style="{StaticResource CardTitle}"/>
          <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Button Content="{l:T Split.AddSelected}" Command="{Binding AddRunningCommand}" Style="{StaticResource AccentButton}"/>
            <Button Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="{l:T Common.Refresh}" Command="{Binding RefreshRunningCommand}"/>
          </WrapPanel>
          <ListBox ItemsSource="{Binding Running}" SelectedItem="{Binding SelectedRunning}" Height="362" ScrollViewer.VerticalScrollBarVisibility="Auto"
                   VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
            <ListBox.ItemTemplate><DataTemplate><StackPanel>
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="NoWrap"/>
              <TextBlock Text="{Binding ExecutablePath}" FontSize="11" Foreground="{DynamicResource SubtleTextBrush}" FlowDirection="LeftToRight" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" FontFamily="{StaticResource LatinFont}"/>
            </StackPanel></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
    </Grid>
    <Border Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock Text="{l:T Split.PreviewTitle}" Style="{StaticResource CardTitle}"/>
        <TextBlock Text="{Binding PreviewText}" LineHeight="22"/>
        <TextBlock Text="{Binding RestartWarning}" Foreground="{DynamicResource WarningBrush}" Margin="0,8,0,0"/>
        <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource DangerBrush}"/>
        <TextBlock Text="{l:T Split.HowItWorks}" Style="{StaticResource Subtle}" Margin="0,10,0,0"/>
      </StackPanel>
    </Border>
  </StackPanel>
  </ScrollViewer>
</UserControl>
