<UserControl x:Class="Koalix.App.Views.ProfilesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:Koalix.App.Localization" xmlns:svc="clr-namespace:Koalix.App.Services" xmlns:c="clr-namespace:Koalix.App.Controls">
  <DockPanel>
    <StackPanel x:Name="Cards" DockPanel.Dock="Top">
      <TextBlock Text="{l:T Profiles.Title}" Style="{StaticResource Title}"/>
      <TextBlock Text="{l:T Profiles.Subtitle}" Style="{StaticResource Subtitle}"/>
      <!-- v0.4.19 layout fix (user: «خیلی بد شده بخش تونل … کلا دوتا کانفیگ قابل دیدن هست»): the import
           box used to eat ~330 px of the page and starved the list — it is now COLLAPSED behind one button
           and expands only when needed, so the config list gets the room it deserves. -->
      <Border Style="{StaticResource Card}" Padding="14,10">
        <StackPanel>
          <Button Click="ImportHeader_Click" Cursor="Hand" Focusable="False">
            <Button.Template>
              <ControlTemplate TargetType="Button">
                <Border x:Name="bd" Background="Transparent" CornerRadius="8" Padding="4,3">
                  <StackPanel Orientation="Horizontal">
                    <Border Width="26" Height="26" CornerRadius="8" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Center">
                      <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="13" HorizontalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                    </Border>
                    <TextBlock x:Name="hdr" Text="{l:T Profiles.AddConfig}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <TextBlock Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource SubtleTextBrush}"
                               RenderTransformOrigin="0.5,0.5"><TextBlock.RenderTransform><RotateTransform x:Name="Chev"/></TextBlock.RenderTransform></TextBlock>
                  </StackPanel>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource ControlHoverBrush}"/></Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Button.Template>
          </Button>
          <StackPanel x:Name="ImportBody" Visibility="Collapsed" Margin="2,10,2,0">
            <TextBlock Text="{l:T Profiles.ImportHint}" Style="{StaticResource Subtle}" Margin="0,0,0,8"/>
            <TextBox x:Name="ImportBox" Text="{Binding ImportText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CodeBox}" Height="90"/>
            <WrapPanel Margin="0,8,0,0">
              <TextBox Text="{Binding ImportName, UpdateSourceTrigger=PropertyChanged}" Width="200" ToolTip="{l:T Profiles.Name}" Tag="{l:T Profiles.Name}" Margin="0,0,8,8"/>
              <!-- v0.4.12: optional group label — merges everything imported in this batch under one tag -->
              <TextBox Visibility="{Binding IsAdvanced, Source={x:Static svc:UiMode.I}, Converter={StaticResource BoolToVis}}" Text="{Binding ImportTag, UpdateSourceTrigger=PropertyChanged}" Width="160" ToolTip="{l:T Profiles.Tag}" Tag="{l:T Profiles.Tag}" Margin="0,0,8,8"/>
              <!-- v0.4.20 (user: «کاش یک گزینه بزاری کل گروه یا همون لینک سابی که اضافه میکنیم و بشه انتخاب کنیم سینگ باکس باشه موتورش یا xray»):
                   engine picker — Auto / sing-box / Xray for the whole subscription; the choice is SAVED on the sub
                   and every refresh keeps it. The fix for "everything lands on sing-box". -->
              <ComboBox Visibility="{Binding IsAdvanced, Source={x:Static svc:UiMode.I}, Converter={StaticResource BoolToVis}}" ItemsSource="{Binding ImportEngineChoices}" SelectedIndex="{Binding ImportEngine}" MinWidth="128" Margin="0,0,8,8" VerticalAlignment="Center"
                        ToolTip="{l:T Profiles.EnginePickTip}">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="&#xE945;" Style="{StaticResource Icon}" FontSize="11" Margin="0,1,7,0" Foreground="{DynamicResource SubtleTextBrush}" Visibility="Collapsed"/>
                      <TextBlock TextWrapping="NoWrap">
                        <TextBlock.Text><MultiBinding Converter="{x:Static l:LocMulti.Instance}" ConverterParameter="EnginePick"><Binding/><Binding Path="Language" Source="{x:Static l:Loc.I}"/></MultiBinding></TextBlock.Text>
                      </TextBlock>
                    </StackPanel>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <Button Content="{l:T Profiles.Import}" Command="{Binding ImportCommand}" Style="{StaticResource AccentButton}"/>
              <Button Content="{l:T Profiles.ImportFile}" Command="{Binding ImportFileCommand}"/>
            </WrapPanel>
            <TextBlock Text="{l:T Profiles.MultiSubHint}" Style="{StaticResource Subtle}" FontSize="11" Margin="0,6,0,0"/>
            <TextBlock Text="{l:T Profiles.DropHint}" Style="{StaticResource Subtle}" FontSize="11" Margin="0,4,0,0"/>
          </StackPanel>
        </StackPanel>
      </Border>
      <!-- ═══ Saved subscriptions (v0.4.12 dedicated section): rename, group-tag, update, remove ═══ -->
      <Border Margin="0,10,0,0">
        <Border.Style>
          <Style TargetType="Border" BasedOn="{StaticResource Card}">
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding Subs.Count}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <StackPanel>
          <TextBlock Text="{l:T Sub.Title}" Style="{StaticResource CardTitle}" Margin="0"/>
          <!-- v0.4.19: many subscriptions can no longer starve the list — the section scrolls internally. -->
          <ScrollViewer MaxHeight="176" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Subs}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border CornerRadius="10" Background="{DynamicResource ControlBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="12,9" Margin="0,6,0,0">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                        <Style.Triggers><DataTrigger Binding="{Binding IsDead}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/></DataTrigger></Style.Triggers>
                      </Style>
                    </Border.Style>
                    <StackPanel>
                      <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                          <!-- v0.4.23 (suggestion #5): the sub URL itself is shareable — QR straight to the phone. -->
                          <Button Command="{Binding DataContext.ShareCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                  Style="{StaticResource IconButton}" Content="&#xE72D;" ToolTip="{l:T Profiles.ShareTip}" Margin="0,0,6,0"/>
                          <Button Command="{Binding DataContext.UpdateSubCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                  Style="{StaticResource AccentButton}" Content="{l:T Sub.Update}" Margin="0,0,6,0" Padding="12,4"/>
                          <Button Command="{Binding DataContext.RenameSubCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                  Content="{l:T Sub.Rename}" Padding="12,4" ToolTip="{l:T Sub.RenameTip}"/>
                          <Button Command="{Binding DataContext.TagSubServersCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                  Content="{l:T Sub.TagServers}" Padding="12,4" ToolTip="{l:T Sub.TagServersTip}" Margin="6,0,0,0"/>
                          <Button Command="{Binding DataContext.RemoveSubCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                  Content="{l:T Common.Delete}" Padding="12,4" Margin="6,0,0,0"/>
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontWeight="Bold" TextTrimming="WordEllipsis" TextWrapping="NoWrap"/>
                            <!-- v0.4.20: the sub's forced engine chip (empty = auto) -->
                            <Border Style="{StaticResource Pill}" Padding="7,0" Margin="8,0,0,0" Background="{DynamicResource AccentSoftBrush}" Visibility="{Binding EngineText, Converter={StaticResource NullToCollapsed}}">
                              <TextBlock Text="{Binding EngineText}" FontSize="10.5" Foreground="{DynamicResource AccentBrush}" FontFamily="{StaticResource LatinFont}" TextWrapping="NoWrap"/>
                            </Border>
                          </StackPanel>
                          <TextBlock Text="{Binding Meta}" Style="{StaticResource Subtle}" FontSize="11" Margin="0,2,0,0" TextTrimming="WordEllipsis" TextWrapping="NoWrap"/>
                        </StackPanel>
                      </DockPanel>
                      <!-- v0.4.20 (user: «بخش جدا برای ساب لینک‌ها با نمایش حجم و زمان»): the panel-reported
                           volume bar (green → amber at 80% → red when exhausted) + the expiry chip. -->
                      <Grid Margin="0,8,0,0" Visibility="{Binding HasVolume, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <ProgressBar Height="6" BorderThickness="0" Value="{Binding VolumePct}" Maximum="100" VerticalAlignment="Center" c:Fx.Equalize="True">
                          <ProgressBar.Style>
                            <Style TargetType="ProgressBar">
                              <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding VolumeLevel}" Value="2"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/></DataTrigger>
                                <DataTrigger Binding="{Binding VolumeLevel}" Value="3"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/></DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </ProgressBar.Style>
                        </ProgressBar>
                        <TextBlock Grid.Column="1" Text="{Binding VolumeText}" Margin="10,0,0,0" VerticalAlignment="Center" FontFamily="{StaticResource LatinFont}" FlowDirection="LeftToRight" FontWeight="SemiBold" FontSize="11.5"/>
                        <Border Grid.Column="2" CornerRadius="7" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="{Binding HasExpiry, Converter={StaticResource BoolToVis}}">
                          <Border.Style>
                            <Style TargetType="Border">
                              <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}"/>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding ExpireLevel}" Value="2"><Setter Property="Background" Value="{DynamicResource WarningSoftBrush}"/></DataTrigger>
                                <DataTrigger Binding="{Binding ExpireLevel}" Value="3"><Setter Property="Background" Value="{DynamicResource DangerSoftBrush}"/></DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Border.Style>
                          <TextBlock Text="{Binding ExpireText}" FontSize="10.5" FontWeight="SemiBold"/>
                        </Border>
                      </Grid>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </StackPanel>
      </Border>
    </StackPanel>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition x:Name="PreviewCol" Width="*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}">
        <DockPanel>
          <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <ComboBox ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter}" MinWidth="120" Margin="0,0,8,8">
              <ComboBox.ItemTemplate><DataTemplate><TextBlock TextWrapping="NoWrap"><TextBlock.Text><MultiBinding Converter="{x:Static l:LocMulti.Instance}" ConverterParameter="Engine"><Binding /><Binding Path="Language" Source="{x:Static l:Loc.I}"/></MultiBinding></TextBlock.Text></TextBlock></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
            <!-- v0.4.12: group/tag filter -->
            <ComboBox ItemsSource="{Binding TagFilters}" SelectedItem="{Binding TagFilter}" MinWidth="120" Margin="0,0,8,8"
                      ToolTip="{l:T Profiles.TagFilter}"/>
            <Button Command="{Binding TestAllCommand}" Style="{StaticResource AccentButton}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xEC48;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/>
                <TextBlock TextWrapping="NoWrap">
                  <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="{l:T Profiles.TestAll}"/><Style.Triggers>
                    <DataTrigger Binding="{Binding IsTesting}" Value="True"><Setter Property="Text" Value="{l:T Profiles.Testing}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
              </StackPanel>
            </Button>
            <Button Content="{l:T Profiles.TestSelected}" Command="{Binding TestSelectedCommand}"/>
          </WrapPanel>
          <!-- v0.4.23 (user: «بخش تونل ها هم اون پایینش که تست و این چیزاس خیلی شلوغ شده … تو حالت Resize که کوچکه و فول اسکرین نیست خیلی شلوغه حتی نمیشه درست سرورارو دید»):
               the card used to keep TWO full button rows + hints (~120 px) docked at the bottom, starving the server
               list in small windows. NOTHING was removed — every tool now lives inside this collapsible panel
               (collapsed by default) behind one compact toggle, so the page opens with a single row + the list. -->
          <Border x:Name="ToolsPanel" DockPanel.Dock="Bottom" Background="{DynamicResource ControlBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,8,0,0" Visibility="Collapsed">
            <StackPanel>
              <WrapPanel>
                <Button Content="{l:T Profiles.SetTag}" Command="{Binding SetTagCommand}" ToolTip="{l:T Profiles.SetTagTip}"/>
                <Button Content="{l:T Gaming.TestSelected}" Command="{Binding TestGamingSelectedCommand}"/>
                <Button Content="{l:T Gaming.TestAll}" Command="{Binding TestGamingAllCommand}"/>
                <Button Content="{l:T Profiles.Validate}" Command="{Binding ValidateCommand}"/>
                <Button Content="{l:T Profiles.SwitchEngine}" Command="{Binding SwitchEngineCommand}"/>
                <!-- v0.4.20 (user: «کانفیگایی ک پینگ ندادن و حذف کنه»): one click removes everything whose last test
                     failed; the switch makes every full test clean up after itself (the connected server is never touched). -->
                <Button Content="{l:T Profiles.RemoveDead}" Command="{Binding RemoveDeadCommand}" Padding="12,4"/>
                <CheckBox Content="{l:T Profiles.AutoClean}" IsChecked="{Binding AutoClean}" VerticalAlignment="Center" Margin="0,0,8,8" ToolTip="{l:T Profiles.AutoCleanTip}"/>
                <!-- v0.4.23: Delete is a destructive bulk action — kept available but demoted out of the primary row. -->
                <Button Content="{l:T Common.Delete}" Command="{Binding DeleteCommand}" Style="{StaticResource DangerButton}"/>
              </WrapPanel>
              <TextBlock Style="{StaticResource Subtle}" FontSize="11" TextWrapping="Wrap" Margin="2,2,2,0">
                <Run Text="{l:T Profiles.DragHint}"/><LineBreak/><Run Text="{l:T Profiles.PingHint}"/>
              </TextBlock>
            </StackPanel>
          </Border>
          <!-- v0.4.23: the only row that always stays visible — Connect (primary) + Share + the tools toggle. -->
          <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Button Command="{Binding ConnectCommand}" Style="{StaticResource AccentButton}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/>
                <TextBlock Text="{l:T Profiles.Connect}" TextWrapping="NoWrap"/>
              </StackPanel>
            </Button>
            <!-- v0.4.23 (suggestion #5): QR + link for the selected config — sends it to the phone. -->
            <Button Command="{Binding ShareCommand}" CommandParameter="{Binding SelectedRow}" ToolTip="{l:T Profiles.ShareTip}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE72D;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/>
                <TextBlock Text="{l:T Profiles.Share}" TextWrapping="NoWrap"/>
              </StackPanel>
            </Button>
            <Button Visibility="{Binding IsAdvanced, Source={x:Static svc:UiMode.I}, Converter={StaticResource BoolToVis}}" Click="Tools_Click">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="10" RenderTransformOrigin="0.5,0.5"><TextBlock.RenderTransform><RotateTransform x:Name="ToolsChevron"/></TextBlock.RenderTransform></TextBlock>
                <TextBlock Text="{l:T Profiles.Tools}" VerticalAlignment="Center" Margin="7,0,0,0" TextWrapping="NoWrap"/>
              </StackPanel>
            </Button>
          </WrapPanel>
          <!-- v0.4.20 multi-select bulk bar: appears the moment at least one row is ticked.
               v0.4.24 (audit fix): was a DockPanel — the three right-docked buttons (Delete/Switch/Move)
               squeezed the left count row and the trailing «انتخاب همه» button was CLIPPED in narrow windows.
               Now one WrapPanel: nothing is ever cut off, the actions simply flow to a second row. The
               Select-All button also toggles its label (Select all ↔ Deselect all) via AllSelected. -->
          <Border DockPanel.Dock="Top" CornerRadius="10" Padding="10,6" Margin="0,0,0,8" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                  Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
            <WrapPanel>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                <TextBlock Text="{Binding SelectedCount}" FontWeight="Bold" Style="{StaticResource Latin}"/>
                <TextBlock Text="{l:T Profiles.SelectedCount}" Margin="6,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>
              <Button Command="{Binding ToggleSelectAllCommand}" Padding="12,4" Margin="0,0,6,4" MinWidth="96" Focusable="False" VerticalAlignment="Center">
                <Button.Content>
                  <TextBlock TextWrapping="NoWrap">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                        <Setter Property="Text" Value="{l:T Profiles.SelectAll}"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding AllSelected}" Value="True">
                            <Setter Property="Text" Value="{l:T Profiles.DeselectAll}"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </Button.Content>
              </Button>
              <Button Content="{l:T Profiles.MoveGroup}" Command="{Binding MoveSelectedToGroupCommand}" Padding="12,4" Margin="0,0,6,4" VerticalAlignment="Center"/>
              <Button Content="{l:T Profiles.SwitchEngine}" Command="{Binding SwitchEngineSelectedCommand}" Padding="12,4" Margin="0,0,6,4" VerticalAlignment="Center"/>
              <Button Content="{l:T Common.Delete}" Command="{Binding DeleteSelectedCommand}" Style="{StaticResource DangerButton}" Padding="12,4" Margin="0,0,0,4" VerticalAlignment="Center"/>
            </WrapPanel>
          </Border>
          <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Margin="2,6,2,0"/>
          <!-- v0.4.23: the drag/ping hints moved into the collapsible ToolsPanel above (they are reference text, not feedback). -->
          <!-- v0.4.19: no MinHeight any more — that 240 px minimum made the list OVERFLOW its card (the rows
               drew over the hints/buttons and the scrollbar "disappeared" while dragging, user report). The
               list now takes exactly the space the card has left, with a properly bounded scrollbar. -->
          <Grid>
            <!-- v0.4.32: skeleton rows while an import / subscription download is running -->
            <Border Panel.ZIndex="5" Background="{DynamicResource WindowBrush}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" IsHitTestVisible="False">
              <StackPanel Margin="2,2,2,0">
                <Border Background="{DynamicResource CardBrush}" CornerRadius="10" Padding="12,10" Margin="0,0,0,6" Opacity="1">
                  <DockPanel>
                    <c:Skeleton DockPanel.Dock="Left" Width="26" Height="26" CornerRadius="8" Margin="0,0,12,0"/>
                    <c:Skeleton DockPanel.Dock="Right" Width="44" Height="16" CornerRadius="8" Margin="12,0,0,0"/>
                    <StackPanel VerticalAlignment="Center">
                      <c:Skeleton Width="180" HorizontalAlignment="Left"/>
                      <c:Skeleton Width="110" Height="8" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                    </StackPanel>
                  </DockPanel>
                </Border>
                <Border Background="{DynamicResource CardBrush}" CornerRadius="10" Padding="12,10" Margin="0,0,0,6" Opacity="0.8">
                  <DockPanel>
                    <c:Skeleton DockPanel.Dock="Left" Width="26" Height="26" CornerRadius="8" Margin="0,0,12,0"/>
                    <c:Skeleton DockPanel.Dock="Right" Width="44" Height="16" CornerRadius="8" Margin="12,0,0,0"/>
                    <StackPanel VerticalAlignment="Center">
                      <c:Skeleton Width="150" HorizontalAlignment="Left"/>
                      <c:Skeleton Width="90" Height="8" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                    </StackPanel>
                  </DockPanel>
                </Border>
                <Border Background="{DynamicResource CardBrush}" CornerRadius="10" Padding="12,10" Margin="0,0,0,6" Opacity="0.6">
                  <DockPanel>
                    <c:Skeleton DockPanel.Dock="Left" Width="26" Height="26" CornerRadius="8" Margin="0,0,12,0"/>
                    <c:Skeleton DockPanel.Dock="Right" Width="44" Height="16" CornerRadius="8" Margin="12,0,0,0"/>
                    <StackPanel VerticalAlignment="Center">
                      <c:Skeleton Width="200" HorizontalAlignment="Left"/>
                      <c:Skeleton Width="120" Height="8" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                    </StackPanel>
                  </DockPanel>
                </Border>
                <Border Background="{DynamicResource CardBrush}" CornerRadius="10" Padding="12,10" Margin="0,0,0,6" Opacity="0.4">
                  <DockPanel>
                    <c:Skeleton DockPanel.Dock="Left" Width="26" Height="26" CornerRadius="8" Margin="0,0,12,0"/>
                    <c:Skeleton DockPanel.Dock="Right" Width="44" Height="16" CornerRadius="8" Margin="12,0,0,0"/>
                    <StackPanel VerticalAlignment="Center">
                      <c:Skeleton Width="130" HorizontalAlignment="Left"/>
                      <c:Skeleton Width="80" Height="8" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                    </StackPanel>
                  </DockPanel>
                </Border>
              </StackPanel>
            </Border>
            <ListBox x:Name="List" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     AllowDrop="True" PreviewMouseLeftButtonDown="List_PreviewMouseLeftButtonDown" PreviewMouseMove="List_PreviewMouseMove"
                     DragOver="List_DragOver" Drop="List_Drop" DragLeave="List_DragLeave">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <DockPanel>
                    <!-- v0.4.20 multi-select tick: bulk group / engine-switch / delete on ticked rows. -->
                    <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" Command="{Binding DataContext.RowTickedCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" VerticalAlignment="Center" Margin="0,0,10,0" Focusable="False"/>
                    <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="10" Background="{DynamicResource AccentSoftBrush}">
                      <TextBlock x:Name="glyph" Text="&#xE774;" Style="{StaticResource Icon}" FontSize="15" HorizontalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                    </Border>
                    <!-- ping badge -->
                    <Border x:Name="ping" DockPanel.Dock="Right" Style="{StaticResource Pill}" MinWidth="64" Background="{DynamicResource ControlBrush}" ToolTip="{Binding PingNote}">
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" FlowDirection="LeftToRight">
                        <Border x:Name="pingDot" Width="7" Height="7" CornerRadius="2.5" Background="{DynamicResource SubtleTextBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="pingText" Text="{Binding Ping}" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource SubtleTextBrush}" FontFamily="{StaticResource LatinFont}" TextWrapping="NoWrap"/>
                        <TextBlock x:Name="pingUnit" Text=" ms" FontSize="11" Foreground="{DynamicResource SubtleTextBrush}" FontFamily="{StaticResource LatinFont}" Visibility="Collapsed" TextWrapping="NoWrap"/>
                        <TextBlock x:Name="tcpTag" Text=" TCP" FontSize="10" Foreground="{DynamicResource SubtleTextBrush}" FontFamily="{StaticResource LatinFont}" Visibility="Collapsed" TextWrapping="NoWrap"/>
                      </StackPanel>
                    </Border>
                    <!-- gaming verdict badge -->
                    <Border x:Name="gaming" DockPanel.Dock="Right" Style="{StaticResource Pill}" MinWidth="62" Background="{DynamicResource ControlBrush}" Margin="6,0,0,0" ToolTip="{Binding GamingNote}" Visibility="Collapsed">
                      <TextBlock x:Name="gamingText" Text="{Binding GamingText}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource SubtleTextBrush}" TextWrapping="NoWrap" HorizontalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0" VerticalAlignment="Center">
                      <!-- LTR: FaNum digits + RTL base reorder IP octets ("84.21" -> "21.84"); LTR keeps Latin names intact, Persian names still shape fine. -->
                      <TextBlock Text="{Binding Name}" FontWeight="Bold" TextTrimming="WordEllipsis" TextWrapping="NoWrap" FlowDirection="LeftToRight"/>
                      <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <Border Style="{StaticResource Pill}" Padding="7,0" Background="{DynamicResource AccentSoftBrush}">
                          <TextBlock Text="{Binding Engine}" FontSize="10.5" Foreground="{DynamicResource AccentBrush}" FontFamily="{StaticResource LatinFont}" TextWrapping="NoWrap"/>
                        </Border>
                        <Border Style="{StaticResource Pill}" Padding="7,0" Margin="6,0,0,0" Background="{DynamicResource ControlBrush}">
                          <TextBlock Text="{Binding Source}" FontSize="10.5" FontFamily="{StaticResource LatinFont}" TextWrapping="NoWrap"/>
                        </Border>
                        <!-- v0.4.12: group tag chip -->
                        <Border Style="{StaticResource Pill}" Padding="7,0" Margin="6,0,0,0" Background="{DynamicResource WarningSoftBrush}" Visibility="{Binding Tag, Converter={StaticResource NullToCollapsed}}">
                          <TextBlock Text="{Binding Tag}" FontSize="10.5" Foreground="{DynamicResource WarningBrush}" TextWrapping="NoWrap"/>
                        </Border>
                      </StackPanel>
                    </StackPanel>
                  </DockPanel>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Engine}" Value="WireGuard"><Setter TargetName="glyph" Property="Text" Value="&#xE72E;"/></DataTrigger>
                    <DataTrigger Binding="{Binding Engine}" Value="Xray"><Setter TargetName="glyph" Property="Text" Value="&#xE945;"/></DataTrigger>
                    <DataTrigger Binding="{Binding Engine}" Value="OpenVpn"><Setter TargetName="glyph" Property="Text" Value="&#xE753;"/></DataTrigger>
                    <DataTrigger Binding="{Binding PingLevel}" Value="1">
                      <Setter TargetName="ping" Property="Background" Value="{DynamicResource SuccessSoftBrush}"/><Setter TargetName="pingDot" Property="Background" Value="{DynamicResource SuccessBrush}"/>
                      <Setter TargetName="pingText" Property="Foreground" Value="{DynamicResource SuccessBrush}"/><Setter TargetName="pingUnit" Property="Visibility" Value="Visible"/></DataTrigger>
                    <DataTrigger Binding="{Binding PingLevel}" Value="2">
                      <Setter TargetName="ping" Property="Background" Value="{DynamicResource WarningSoftBrush}"/><Setter TargetName="pingDot" Property="Background" Value="{DynamicResource WarningBrush}"/>
                      <Setter TargetName="pingText" Property="Foreground" Value="{DynamicResource WarningBrush}"/><Setter TargetName="pingUnit" Property="Visibility" Value="Visible"/></DataTrigger>
                    <DataTrigger Binding="{Binding PingLevel}" Value="3">
                      <Setter TargetName="ping" Property="Background" Value="{DynamicResource DangerSoftBrush}"/><Setter TargetName="pingDot" Property="Background" Value="{DynamicResource WarningBrush}"/>
                      <Setter TargetName="pingText" Property="Foreground" Value="{DynamicResource WarningBrush}"/><Setter TargetName="pingUnit" Property="Visibility" Value="Visible"/></DataTrigger>
                    <DataTrigger Binding="{Binding PingLevel}" Value="4">
                      <Setter TargetName="ping" Property="Background" Value="{DynamicResource DangerSoftBrush}"/><Setter TargetName="pingDot" Property="Background" Value="{DynamicResource DangerBrush}"/>
                      <Setter TargetName="pingText" Property="Foreground" Value="{DynamicResource DangerBrush}"/></DataTrigger>
                    <DataTrigger Binding="{Binding PingLevel}" Value="5">
                      <Setter TargetName="pingDot" Property="Background" Value="{DynamicResource AccentBrush}"/><Setter TargetName="pingText" Property="Foreground" Value="{DynamicResource AccentBrush}"/></DataTrigger>
                    <DataTrigger Binding="{Binding IsTcp}" Value="True"><Setter TargetName="tcpTag" Property="Visibility" Value="Visible"/></DataTrigger>
                    <DataTrigger Binding="{Binding GamingLevel}" Value="1">
                      <Setter TargetName="gaming" Property="Visibility" Value="Visible"/><Setter TargetName="gaming" Property="Background" Value="{DynamicResource SuccessSoftBrush}"/>
                      <Setter TargetName="gamingText" Property="Foreground" Value="{DynamicResource SuccessBrush}"/></DataTrigger>
                    <DataTrigger Binding="{Binding GamingLevel}" Value="2">
                      <Setter TargetName="gaming" Property="Visibility" Value="Visible"/><Setter TargetName="gaming" Property="Background" Value="{DynamicResource WarningSoftBrush}"/>
                      <Setter TargetName="gamingText" Property="Foreground" Value="{DynamicResource WarningBrush}"/></DataTrigger>
                    <DataTrigger Binding="{Binding GamingLevel}" Value="3">
                      <Setter TargetName="gaming" Property="Visibility" Value="Visible"/><Setter TargetName="gaming" Property="Background" Value="{DynamicResource DangerSoftBrush}"/>
                      <Setter TargetName="gamingText" Property="Foreground" Value="{DynamicResource DangerBrush}"/></DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <!-- v0.4.19 drag-and-drop insertion cue: the accent line that follows the cursor between rows. -->
            <Border x:Name="DropLine" Height="3" CornerRadius="1.5" Background="{DynamicResource AccentBrush}" Opacity="0.9"
                    Visibility="Collapsed" VerticalAlignment="Top" IsHitTestVisible="False" Margin="6,-1,16,0"/>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
              <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers>
                <DataTrigger Binding="{Binding Rows.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
              <TextBlock Text="&#xE774;" Style="{StaticResource Icon}" FontSize="34" HorizontalAlignment="Center" Foreground="{DynamicResource SubtleTextBrush}" Opacity="0.6"/>
              <TextBlock Text="{l:T Profiles.Empty}" Style="{StaticResource Subtle}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
            </StackPanel>
          </Grid>
        </DockPanel>
      </Border>
      <Border Visibility="{Binding IsAdvanced, Source={x:Static svc:UiMode.I}, Converter={StaticResource BoolToVis}}" Grid.Column="1" Style="{StaticResource Card}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="{l:T Profiles.Preview}" Style="{StaticResource CardTitle}"/>
          <TextBox Text="{Binding Preview, Mode=OneWay}" Style="{StaticResource CodeBox}" IsReadOnly="True"/>
        </DockPanel>
      </Border>
    </Grid>

    <!-- v0.4.23 (suggestion #5): the share dialog — QR square + the raw link/text + copy/save, so any config
         can be sent to the phone in two clicks (the sub cards share their URL; server rows their own link). -->
    <Popup IsOpen="{Binding ShareOpen, Mode=TwoWay}" AllowsTransparency="True" StaysOpen="False" Placement="Center" PopupAnimation="Fade">
      <Border Width="440" MaxHeight="640" CornerRadius="18" Background="{DynamicResource PopupBrush}" BorderBrush="{DynamicResource StrongBorderBrush}" BorderThickness="1" Padding="22,18">
        <Border.Effect><DropShadowEffect BlurRadius="36" ShadowDepth="8" Opacity="0.45" Color="{DynamicResource ShadowColor}"/></Border.Effect>
        <DockPanel>
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Command="{Binding CopyShareTextCommand}" Style="{StaticResource AccentButton}" Padding="14,6">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,7,0"/>
                <TextBlock Text="{Binding ShareIsLinkText}" TextWrapping="NoWrap"/>
              </StackPanel>
            </Button>
            <Button Command="{Binding SaveShareQrCommand}" Padding="14,6" Visibility="{Binding HasQr, Converter={StaticResource BoolToVis}}" Content="{l:T Share.SaveQr}"/>
            <Button Command="{Binding CloseShareCommand}" Padding="14,6" Content="{l:T Common.Close}"/>
          </StackPanel>
          <StackPanel>
            <TextBlock Text="{l:T Share.Title}" Style="{StaticResource CardTitle}" Margin="0"/>
            <TextBlock Text="{Binding ShareTitle}" Style="{StaticResource Subtle}" FontSize="12.5" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
            <!-- the QR itself sits on a white tile: dark-theme-proof and maximum scanner contrast -->
            <Border Width="264" Height="264" CornerRadius="14" Background="White" HorizontalAlignment="Center" Margin="0,14,0,0" Padding="14">
              <Grid>
                <Image Source="{Binding ShareQrImage}" Stretch="Uniform"/>
                <TextBlock Text="{l:T Share.NoLink}" Foreground="#90000000" FontSize="12.5" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Padding="12">
                  <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers><DataTrigger Binding="{Binding HasQr}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
              </Grid>
            </Border>
            <TextBlock Text="{l:T Share.QrHint}" Style="{StaticResource Subtle}" FontSize="11.5" HorizontalAlignment="Center" Margin="0,8,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
            <Border CornerRadius="10" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="10,7" Margin="0,12,0,0">
              <TextBox Text="{Binding ShareText, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource CodeBox}" MaxHeight="96" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" BorderThickness="0" Background="Transparent"/>
            </Border>
          </StackPanel>
        </DockPanel>
      </Border>
    </Popup>
  </DockPanel>
</UserControl>
