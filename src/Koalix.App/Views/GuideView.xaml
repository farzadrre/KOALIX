<UserControl x:Class="Koalix.App.Views.GuideView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:Koalix.App.Localization" xmlns:c="clr-namespace:Koalix.App.Controls">
  <!-- v0.4.42 — آموزش (Guide): mode picker + tour, a live quick-start checklist, lessons, troubleshooting, shortcuts. -->
  <UserControl.Resources>
    <!-- foldable header of a lesson / troubleshooting card -->
    <Style x:Key="TopicHeader" TargetType="Button">
      <Setter Property="Margin" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="Transparent" CornerRadius="12" Padding="14,11">
              <ContentPresenter HorizontalAlignment="Stretch"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- the two big Beginner / Advanced cards — Tag carries "is this the active mode" -->
    <Style x:Key="ModeCard" TargetType="Button">
      <Setter Property="Margin" Value="0,0,10,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="b" CornerRadius="14" Padding="16,14" Background="{DynamicResource ControlBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5">
                <ContentPresenter/>
              </Border>
              <Border x:Name="tick" Width="22" Height="22" CornerRadius="11" Background="{DynamicResource AccentGradientBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0" Visibility="Collapsed">
                <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="11" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource StrongBorderBrush}"/>
              </Trigger>
              <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                <Setter TargetName="b" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
              </DataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Cap" TargetType="Border">
      <Setter Property="MinWidth" Value="30"/>
      <Setter Property="Height" Value="26"/>
      <Setter Property="Padding" Value="8,0"/>
      <Setter Property="Margin" Value="0,0,5,0"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Background" Value="{DynamicResource ControlBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource StrongBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1,1,1,2.5"/>
    </Style>
    <Style x:Key="CapText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="FontFamily" Value="{DynamicResource LatinFont}"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <DataTemplate x:Key="TopicTpl">
      <Border Margin="0,0,0,8" CornerRadius="12" Background="{DynamicResource ControlBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <StackPanel>
          <Button Style="{StaticResource TopicHeader}" Command="{Binding ToggleCommand}">
            <DockPanel LastChildFill="True">
              <Border DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="10" Background="{DynamicResource AccentSoftBrush}" Margin="0,0,12,0">
                <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="15" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <TextBlock DockPanel.Dock="Right" Text="&#xE70D;" FontSize="11" Foreground="{DynamicResource SubtleTextBrush}" VerticalAlignment="Center" Margin="10,0,2,0" RenderTransformOrigin="0.5,0.5">
                <TextBlock.Style>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                    <Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="0"/></Setter.Value></Setter>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsOpen}" Value="True">
                        <Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="180"/></Setter.Value></Setter>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
              <Border DockPanel.Dock="Right" Style="{StaticResource Pill}" Background="{DynamicResource WarningSoftBrush}" Padding="8,2" Margin="8,0,0,0"
                      Visibility="{Binding Advanced, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{l:T Mode.Advanced}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource WarningBrush}"/>
              </Border>
              <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </DockPanel>
          </Button>
          <StackPanel Margin="60,0,18,14" Visibility="{Binding IsOpen, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding Body}" TextWrapping="Wrap" LineHeight="23" Foreground="{DynamicResource TextBrush}" Opacity="0.92"/>
            <Button Content="{Binding ActionText}" Command="{Binding RunCommand}" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,10,0,0"
                    Visibility="{Binding HasAction, Converter={StaticResource BoolToVis}}"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel x:Name="Cards" Margin="0,0,0,16">
      <TextBlock Text="{l:T Guide.Title}" Style="{StaticResource Title}"/>
      <TextBlock Text="{l:T Guide.Subtitle}" Style="{StaticResource Subtitle}"/>

      <!-- hero: replay the animated tour + choose Beginner / Advanced -->
      <Border Style="{StaticResource Card}" Margin="0,10,14,14" Padding="22,20">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="260"/>
            <ColumnDefinition Width="1.4*"/>
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
            <Border Width="54" Height="54" CornerRadius="16" Background="{DynamicResource AccentGradientBrush}" HorizontalAlignment="Left">
              <TextBlock Text="&#xE7BE;" Style="{StaticResource Icon}" FontSize="24" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="{l:T Guide.HeroTitle}" FontSize="19" FontWeight="Bold" Margin="0,12,0,4" TextWrapping="Wrap"/>
            <TextBlock Text="{l:T Guide.HeroText}" Style="{StaticResource Subtle}" TextWrapping="Wrap" LineHeight="21"/>
            <Button Style="{StaticResource AccentButton}" Command="{Binding ReplayTourCommand}" HorizontalAlignment="Left" Margin="0,14,0,0">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" FontSize="12" Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="{l:T Guide.PlayTour}" Foreground="White" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </StackPanel>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="{l:T Guide.ModeTitle}" Style="{StaticResource CardTitle}"/>
            <TextBlock Text="{l:T Guide.ModeText}" Style="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,2,0,10"/>
            <UniformGrid Columns="2">
              <Button Style="{StaticResource ModeCard}" Command="{Binding ChooseSimpleCommand}" Tag="{Binding Mode.IsSimple}">
                <StackPanel>
                  <TextBlock Text="&#xE7BE;" Style="{StaticResource Icon}" FontSize="20" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Left"/>
                  <TextBlock Text="{l:T Mode.Simple}" FontSize="15" FontWeight="Bold" Margin="0,8,0,3"/>
                  <TextBlock Text="{l:T Guide.SimpleCard}" Style="{StaticResource Subtle}" TextWrapping="Wrap" FontSize="12" LineHeight="19"/>
                </StackPanel>
              </Button>
              <Button Style="{StaticResource ModeCard}" Command="{Binding ChooseAdvancedCommand}" Tag="{Binding Mode.IsAdvanced}" Margin="0">
                <StackPanel>
                  <TextBlock Text="&#xE9E9;" Style="{StaticResource Icon}" FontSize="20" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Left"/>
                  <TextBlock Text="{l:T Mode.Advanced}" FontSize="15" FontWeight="Bold" Margin="0,8,0,3"/>
                  <TextBlock Text="{l:T Guide.AdvancedCard}" Style="{StaticResource Subtle}" TextWrapping="Wrap" FontSize="12" LineHeight="19"/>
                </StackPanel>
              </Button>
            </UniformGrid>
          </StackPanel>
        </Grid>
      </Border>

      <!-- live quick-start checklist -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <DockPanel>
            <TextBlock DockPanel.Dock="Right" Text="{Binding ProgressText}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
            <StackPanel>
              <TextBlock Text="{l:T Guide.CheckTitle}" Style="{StaticResource CardTitle}"/>
              <TextBlock Text="{l:T Guide.CheckText}" Style="{StaticResource Subtle}" TextWrapping="Wrap"/>
            </StackPanel>
          </DockPanel>
          <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="1" Height="8" Margin="0,12,0,14"/>
          <ItemsControl ItemsSource="{Binding Steps}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border CornerRadius="12" Padding="14,11" Margin="0,0,0,8" Background="{DynamicResource ControlBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                  <DockPanel>
                    <Grid DockPanel.Dock="Left" Width="34" Height="34" Margin="0,0,14,0">
                      <Border CornerRadius="17">
                        <Border.Style>
                          <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding Done}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Border.Style>
                      </Border>
                      <TextBlock Text="{Binding Number}" FontFamily="{DynamicResource LatinFont}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Visibility="{Binding Done, Converter={StaticResource InverseBoolToVis}}"/>
                      <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="14" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Visibility="{Binding Done, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding RunCommand}" Margin="10,0,0,0" VerticalAlignment="Center"
                            Visibility="{Binding Done, Converter={StaticResource InverseBoolToVis}}">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ActionText}" VerticalAlignment="Center"/>
                      </StackPanel>
                    </Button>
                    <Border DockPanel.Dock="Right" Style="{StaticResource Pill}" Background="{DynamicResource SuccessSoftBrush}" Margin="10,0,0,0"
                            Visibility="{Binding Done, Converter={StaticResource BoolToVis}}">
                      <TextBlock Text="{l:T Guide.Done}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                      <TextBlock Text="{Binding Text}" Style="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                  </DockPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Border Style="{StaticResource Pill}" Background="{DynamicResource SuccessSoftBrush}" HorizontalAlignment="Left" Padding="12,6" Margin="0,4,0,0"
                  Visibility="{Binding AllDone, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{l:T Guide.AllDone}" Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold" TextWrapping="Wrap"/>
          </Border>
        </StackPanel>
      </Border>

      <!-- step-by-step lessons -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="{l:T Guide.LessonsTitle}" Style="{StaticResource CardTitle}"/>
          <TextBlock Text="{l:T Guide.LessonsText}" Style="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,0,0,12"/>
          <ItemsControl ItemsSource="{Binding Lessons}" ItemTemplate="{StaticResource TopicTpl}"/>
        </StackPanel>
      </Border>

      <!-- troubleshooting -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Command="{Binding OpenRepairCommand}" Margin="10,0,0,0" VerticalAlignment="Top">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE90F;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,7,0" VerticalAlignment="Center"/>
                <TextBlock Text="{l:T Guide.OpenRepair}" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <StackPanel>
              <TextBlock Text="{l:T Guide.TroubleTitle}" Style="{StaticResource CardTitle}"/>
              <TextBlock Text="{l:T Guide.TroubleText}" Style="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,0,0,12"/>
            </StackPanel>
          </DockPanel>
          <ItemsControl ItemsSource="{Binding Troubles}" ItemTemplate="{StaticResource TopicTpl}"/>
        </StackPanel>
      </Border>

      <!-- shortcuts -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="{l:T Guide.KeysTitle}" Style="{StaticResource CardTitle}" Margin="0,0,0,10"/>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" MinWidth="170"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" FlowDirection="LeftToRight" HorizontalAlignment="Left" Margin="0,0,0,10">
              <Border Style="{StaticResource Cap}"><TextBlock Text="Ctrl" Style="{StaticResource CapText}"/></Border>
              <Border Style="{StaticResource Cap}"><TextBlock Text="K" Style="{StaticResource CapText}"/></Border>
            </StackPanel>
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{l:T Guide.KeyPalette}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,10"/>
            <StackPanel Grid.Row="1" Orientation="Horizontal" FlowDirection="LeftToRight" HorizontalAlignment="Left" Margin="0,0,0,10">
              <Border Style="{StaticResource Cap}"><TextBlock Text="Ctrl" Style="{StaticResource CapText}"/></Border>
              <Border Style="{StaticResource Cap}"><TextBlock Text="Alt" Style="{StaticResource CapText}"/></Border>
              <Border Style="{StaticResource Cap}"><TextBlock Text="K" Style="{StaticResource CapText}"/></Border>
            </StackPanel>
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{l:T Guide.KeyConnect}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,10"/>
            <StackPanel Grid.Row="2" Orientation="Horizontal" FlowDirection="LeftToRight" HorizontalAlignment="Left" Margin="0,0,0,10">
              <Border Style="{StaticResource Cap}"><TextBlock Text="W" Style="{StaticResource CapText}"/></Border>
              <Border Style="{StaticResource Cap}"><TextBlock Text="A" Style="{StaticResource CapText}"/></Border>
              <Border Style="{StaticResource Cap}"><TextBlock Text="S" Style="{StaticResource CapText}"/></Border>
              <Border Style="{StaticResource Cap}"><TextBlock Text="D" Style="{StaticResource CapText}"/></Border>
            </StackPanel>
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{l:T Guide.KeyWasd}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,10"/>
            <StackPanel Grid.Row="3" Orientation="Horizontal" FlowDirection="LeftToRight" HorizontalAlignment="Left">
              <Border Style="{StaticResource Cap}"><TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            </StackPanel>
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{l:T Guide.KeyPlus}" VerticalAlignment="Center" TextWrapping="Wrap"/>
          </Grid>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
