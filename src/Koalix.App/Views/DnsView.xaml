<UserControl x:Class="Koalix.App.Views.DnsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:Koalix.App.Localization" xmlns:c="clr-namespace:Koalix.App.Controls">
  <UserControl.Resources>
    <Style x:Key="DnsCardItem" TargetType="ListBoxItem">
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Grid Width="262" Margin="0,0,12,12">
              <Border Style="{StaticResource Card}" Margin="0" Padding="16,14"><ContentPresenter/></Border>
              <Border x:Name="sel" CornerRadius="16" BorderThickness="2" BorderBrush="{DynamicResource AccentGradientBrush}" Opacity="0" IsHitTestVisible="False"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="sel" Property="Opacity" Value="1"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Chip" TargetType="Border">
      <Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="8,4"/><Setter Property="Margin" Value="0,0,6,0"/>
      <Setter Property="Background" Value="{DynamicResource ControlBrush}"/>
    </Style>
  </UserControl.Resources>
  <DockPanel c:Motion.Entrance="True">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="{l:T Dns.Title}" Style="{StaticResource Title}"/>
      <TextBlock Text="{l:T Dns.Subtitle}" Style="{StaticResource Subtitle}"/>

      <!-- Primary actions -->
      <Border Style="{StaticResource FlatCard}" Padding="14,12">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button Style="{StaticResource IconButton}" Content="&#xE710;" ToolTip="{l:T Dns.Add}" Command="{Binding ToggleAddCommand}" Margin="0"/>
            <Button Style="{StaticResource IconButton}" Content="&#xE8B5;" ToolTip="{l:T Dns.Import}" Command="{Binding ImportCommand}" Margin="0"/>
            <Button Style="{StaticResource IconButton}" Content="&#xEDE1;" ToolTip="{l:T Dns.Export}" Command="{Binding ExportCommand}" Margin="0"/>
            <Button Style="{StaticResource IconButton}" Content="&#xE8C8;" ToolTip="{l:T Dns.Duplicate}" Command="{Binding DuplicateCommand}" Margin="0"/>
            <Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="{l:T Common.Delete}" Command="{Binding DeleteCommand}" Margin="0" Foreground="{DynamicResource DangerBrush}"/>
          </StackPanel>
          <WrapPanel VerticalAlignment="Center">
            <Button Command="{Binding TestAllCommand}" Style="{StaticResource AccentButton}" Margin="0,0,10,0">
              <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE768;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/><TextBlock Text="{l:T Dns.TestAll}" TextWrapping="NoWrap"/></StackPanel>
            </Button>
            <ComboBox ItemsSource="{Binding Strategies}" SelectedItem="{Binding Strategy}" Margin="0,0,10,0" MinWidth="190">
              <ComboBox.ItemTemplate><DataTemplate><TextBlock TextWrapping="NoWrap"><TextBlock.Text><MultiBinding Converter="{x:Static l:LocMulti.Instance}" ConverterParameter="Strategy"><Binding/><Binding Path="Language" Source="{x:Static l:Loc.I}"/></MultiBinding></TextBlock.Text></TextBlock></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
              <ProgressBar Width="150" Value="{Binding Progress}"/>
              <TextBlock Text="{Binding Progress, StringFormat={}{0:0}%}" Style="{StaticResource Subtle}" Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </WrapPanel>
        </DockPanel>
      </Border>

      <!-- Add custom DNS (collapsed by default to keep the page clean) -->
      <Border Style="{StaticResource FlatCard}" Padding="14,12" Visibility="{Binding ShowAdd, Converter={StaticResource BoolToVis}}">
        <StackPanel>
          <TextBlock Text="{l:T Dns.Add}" Style="{StaticResource CardTitle}"/>
          <WrapPanel>
            <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" Width="180" Tag="{l:T Dns.Name}"/>
            <TextBox Text="{Binding NewPrimary, UpdateSourceTrigger=PropertyChanged}" Width="160" Tag="{l:T Dns.Primary}" Style="{StaticResource LatinBox}"/>
            <TextBox Text="{Binding NewSecondary, UpdateSourceTrigger=PropertyChanged}" Width="160" Tag="{l:T Dns.Secondary}" Style="{StaticResource LatinBox}"/>
            <Button Content="{l:T Dns.Add}" Command="{Binding AddCommand}" Style="{StaticResource AccentButton}"/>
          </WrapPanel>
          <TextBlock Text="{l:T Dns.AddHint}" Style="{StaticResource Subtle}"/>
        </StackPanel>
      </Border>

      <!-- Apply to adapter -->
      <Border Style="{StaticResource FlatCard}" Padding="14,12">
        <DockPanel>
          <TextBlock Text="&#xE839;" Style="{StaticResource Icon}" FontSize="18" Foreground="{DynamicResource AccentBrush}" Margin="0,0,12,0"/>
          <WrapPanel VerticalAlignment="Center">
            <ComboBox ItemsSource="{Binding Adapters}" SelectedItem="{Binding SelectedAdapter}" DisplayMemberPath="Name" MinWidth="220" Margin="0,0,10,0"/>
            <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
              <TextBlock Text="{l:T Dns.Adapter}" Style="{StaticResource Subtle}" FontSize="11"/>
              <TextBlock Text="{Binding SelectedAdapter.DnsV4, Converter={x:Static l:JoinConverter.Instance}}" Style="{StaticResource Latin}" FontSize="12" FontWeight="SemiBold"/>
            </StackPanel>
            <Button Content="{l:T Dns.Apply}" Command="{Binding ApplyCommand}" Style="{StaticResource AccentButton}" Margin="0,0,8,0"/>
            <Button Content="{l:T Dns.Restore}" Command="{Binding RestoreCommand}" Margin="0,0,8,0"/>
            <Button Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="{l:T Common.Refresh}" Command="{Binding RefreshAdaptersCommand}" Margin="0"/>
          </WrapPanel>
        </DockPanel>
      </Border>

      <TextBlock Text="{Binding StatusMessage}" Margin="2,0,0,6" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/>
      <TextBlock Text="{Binding ImportReport}" Style="{StaticResource Subtle}" Margin="2,0,0,8"/>
    </StackPanel>

    <!-- DNS cards -->
    <ListBox ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" ItemContainerStyle="{StaticResource DnsCardItem}"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
      <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel>
            <DockPanel Margin="0,0,0,10">
              <Border x:Name="badge" DockPanel.Dock="Left" Width="38" Height="38" CornerRadius="12" Background="{DynamicResource ControlBrush}">
                <Grid>
                  <TextBlock x:Name="rankText" Text="{Binding Rank}" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  <TextBlock x:Name="initial" Text="{Binding Initial}" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" Foreground="{DynamicResource SubtleTextBrush}"/>
                </Grid>
              </Border>
              <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                <TextBlock Text="{Binding Servers}" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{DynamicResource SubtleTextBrush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" FlowDirection="LeftToRight" HorizontalAlignment="Left"/>
              </StackPanel>
            </DockPanel>
            <ProgressBar Value="{Binding Quality}" Height="5" Margin="0,0,0,10"/>
            <UniformGrid Columns="3">
              <StackPanel><TextBlock Text="{l:T Dns.Median}" Style="{StaticResource Subtle}" FontSize="10.5"/><TextBlock Text="{Binding Median}" FontWeight="SemiBold" TextWrapping="NoWrap"/></StackPanel>
              <StackPanel><TextBlock Text="{l:T Dns.Jitter}" Style="{StaticResource Subtle}" FontSize="10.5"/><TextBlock Text="{Binding Jitter}" FontWeight="SemiBold" TextWrapping="NoWrap"/></StackPanel>
              <StackPanel><TextBlock Text="{l:T Dns.Loss}" Style="{StaticResource Subtle}" FontSize="10.5"/><TextBlock Text="{Binding Loss}" FontWeight="SemiBold" TextWrapping="NoWrap"/></StackPanel>
            </UniformGrid>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <Border Style="{StaticResource Chip}"><TextBlock FontSize="10.5" Foreground="{DynamicResource SubtleTextBrush}" TextWrapping="NoWrap"><Run Text="ICMP "/><Run Text="{Binding Icmp, Mode=OneWay}"/></TextBlock></Border>
              <Border Style="{StaticResource Chip}"><TextBlock FontSize="10.5" Foreground="{DynamicResource SubtleTextBrush}" TextWrapping="NoWrap"><Run Text="{l:T Dns.Success}"/><Run Text=" "/><Run Text="{Binding DnsSuccess, Mode=OneWay}"/></TextBlock></Border>
            </StackPanel>
          </StackPanel>
          <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Rank}" Value="0">
              <Setter TargetName="rankText" Property="Visibility" Value="Collapsed"/><Setter TargetName="initial" Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Rank}" Value="1">
              <Setter TargetName="badge" Property="Background" Value="{DynamicResource AccentGradientBrush}"/><Setter TargetName="rankText" Property="Foreground" Value="White"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Rank}" Value="2"><Setter TargetName="badge" Property="Background" Value="{DynamicResource AccentSoftBrush}"/></DataTrigger>
            <DataTrigger Binding="{Binding Rank}" Value="3"><Setter TargetName="badge" Property="Background" Value="{DynamicResource AccentSoftBrush}"/></DataTrigger>
          </DataTemplate.Triggers>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
