<Window x:Class="Koalix.App.Views.TrayPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Koalix.App.Localization"
        xmlns:c="clr-namespace:Koalix.App.Controls"
        Title="KOALIX" Width="268" SizeToContent="Height" MaxHeight="480"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        AllowsTransparency="True" Background="Transparent" WindowStartupLocation="Manual"
        FontFamily="{DynamicResource UiFont}" FontSize="12" Foreground="{DynamicResource TextBrush}"
        FlowDirection="{Binding Flow, Source={x:Static l:Loc.I}}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal" Deactivated="OnDeactivated"
        KeyDown="OnKeyDown">
  <Window.Resources>
    <!-- v0.4.35 — compact one-line server row. The old row's Style had no Foreground (an explicit Style replaces the
         app's implicit Button style), so its texts fell back to the system's BLACK on the dark card — «متن سرور دیده
         نمیشه». Every text now carries an explicit themed brush. -->
    <Style x:Key="ServerRow" TargetType="Button">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" CornerRadius="8" Padding="7,5" Margin="0,0,0,2" Background="Transparent"
                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="activeBar" Width="3" Height="16" CornerRadius="1.5" Margin="0,0,6,0" Background="{DynamicResource AccentBrush}"
                        VerticalAlignment="Center" Visibility="Collapsed"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <c:FlagBox Code="{Binding FlagCode}" Width="21" Height="15" VerticalAlignment="Center"/>
                  <TextBlock x:Name="name" Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" Margin="8,0,4,0" MaxWidth="132"
                             Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center"
                             ToolTip="{Binding Name}"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding EngineText}" FontSize="9.5" FontFamily="{StaticResource LatinFont}" Margin="0,0,6,0"
                           Foreground="{DynamicResource SubtleTextBrush}" FlowDirection="LeftToRight" TextWrapping="NoWrap" VerticalAlignment="Center" Opacity="0.85"/>
                <Border x:Name="ping" Grid.Column="3" CornerRadius="6" Padding="6,1.5" MinWidth="44" VerticalAlignment="Center" Background="{DynamicResource ControlBrush}">
                  <TextBlock x:Name="pingText" Text="{Binding PingText}" FontSize="10.5" FontWeight="Bold" FontFamily="{StaticResource LatinFont}" HorizontalAlignment="Center"
                             FlowDirection="LeftToRight" TextWrapping="NoWrap" Foreground="{DynamicResource SubtleTextBrush}"/>
                </Border>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
              </Trigger>
              <DataTrigger Binding="{Binding IsActive}" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                <Setter TargetName="activeBar" Property="Visibility" Value="Visible"/>
                <Setter TargetName="name" Property="FontWeight" Value="Bold"/>
              </DataTrigger>
              <!-- colour-coded ping: 0 = fast (green) · 1 = okay (amber) · 2 = slow/unmeasured (subtle) -->
              <DataTrigger Binding="{Binding PingLevel}" Value="0">
                <Setter TargetName="ping" Property="Background" Value="{DynamicResource SuccessSoftBrush}"/>
                <Setter TargetName="pingText" Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
              </DataTrigger>
              <DataTrigger Binding="{Binding PingLevel}" Value="1">
                <Setter TargetName="ping" Property="Background" Value="{DynamicResource WarningSoftBrush}"/>
                <Setter TargetName="pingText" Property="Foreground" Value="{DynamicResource WarningBrush}"/>
              </DataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- small square header button (open app / exit) -->
    <Style x:Key="TrayIconBtn" TargetType="Button">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Width="28" Height="28" CornerRadius="8" Background="{DynamicResource ControlBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
              <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" Style="{StaticResource Icon}" FontSize="12" Foreground="{TemplateBinding Foreground}"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource StrongBorderBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <!-- v0.4.24 modern tray panel, v0.4.35 compact edition («کوچیکترش کنی»): 268 px wide, header icon buttons instead
       of a footer, one-line server rows with readable names. -->
  <Border x:Name="Card" CornerRadius="14" Padding="11,10" BorderThickness="1"
          BorderBrush="{DynamicResource StrongBorderBrush}" Background="{DynamicResource PopupBrush}">
    <Border.Effect>
      <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.4"/>
    </Border.Effect>
    <StackPanel>
      <!-- header: logo + live status · open / exit -->
      <DockPanel Margin="1,0,1,9" LastChildFill="True">
        <Grid DockPanel.Dock="Left" Width="28" Height="28">
          <Border x:Name="LogoGlow" CornerRadius="9" Background="{DynamicResource AccentBrush}" Opacity="0.4" Width="28" Height="28">
            <Border.Effect><BlurEffect Radius="9"/></Border.Effect>
          </Border>
          <Image Source="pack://application:,,,/KOALIX;component/Assets/koalix.png" Width="26" Height="26" RenderOptions.BitmapScalingMode="HighQuality"/>
        </Grid>
        <Button DockPanel.Dock="Right" Style="{StaticResource TrayIconBtn}" Content="&#xE7E8;" Click="OnExit" Margin="5,0,0,0"
                ToolTip="{l:T Tray.Exit}" Foreground="{DynamicResource DangerBrush}"/>
        <Button DockPanel.Dock="Right" Style="{StaticResource TrayIconBtn}" Content="&#xE8A7;" Click="OnShow" ToolTip="{l:T Tray.Show}"/>
        <Button DockPanel.Dock="Right" Style="{StaticResource TrayIconBtn}" Content="&#xE9D9;" Click="OnWidget" ToolTip="{l:T Tray.Widget}" Margin="0,0,5,0"/>
        <StackPanel VerticalAlignment="Center" Margin="9,0,6,0">
          <TextBlock Text="KOALIX" FontFamily="{StaticResource LatinFont}" FontWeight="Black" FontSize="13.5" Foreground="{DynamicResource AccentTextGradientBrush}" TextWrapping="NoWrap"/>
          <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
            <Border x:Name="StateDot" Width="7" Height="7" CornerRadius="3.5" Background="{DynamicResource SubtleTextBrush}" VerticalAlignment="Center"/>
            <TextBlock x:Name="StateText" Text="KOALIX" Margin="6,0,0,0" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SubtleTextBrush}"
                       VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="130"/>
          </StackPanel>
        </StackPanel>
      </DockPanel>

      <!-- the connect / disconnect button -->
      <Button x:Name="ConnectButton" Click="OnConnect" Cursor="Hand" Focusable="False" Margin="0,0,0,9" RenderTransformOrigin="0.5,0.5">
        <Button.RenderTransform><ScaleTransform x:Name="ConnectScale"/></Button.RenderTransform>
        <Button.Template>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" CornerRadius="10" Padding="0,8" Background="{DynamicResource AccentGradientBrush}">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock x:Name="glyph" Text="&#xE768;" Style="{StaticResource Icon}" FontSize="12.5" Foreground="White" VerticalAlignment="Center"/>
                <TextBlock x:Name="label" Text="{Binding ConnectLabel, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="White" FontWeight="Bold" FontSize="12.5" Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="NoWrap"/>
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Opacity" Value="0.9"/>
              </Trigger>
              <DataTrigger Binding="{Binding ConnectGlyph, RelativeSource={RelativeSource AncestorType=Window}}" Value="stop">
                <Setter TargetName="glyph" Property="Text" Value="&#xE71A;"/>
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource DangerBrush}"/>
              </DataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Button.Template>
      </Button>

      <!-- server list -->
      <TextBlock x:Name="ServersTitle" Text="{l:T Tray.Servers}" Foreground="{DynamicResource SubtleTextBrush}" FontSize="10.5" FontWeight="SemiBold" Margin="3,0,3,4" TextWrapping="NoWrap"/>
      <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="232">
        <ItemsControl x:Name="ServerList">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Style="{StaticResource ServerRow}" Click="OnServerClick"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      <TextBlock x:Name="NoServers" Text="{l:T Tray.NoServers}" Foreground="{DynamicResource SubtleTextBrush}" FontSize="11.5" Margin="3,2" TextWrapping="NoWrap"/>
    </StackPanel>
  </Border>
</Window>
