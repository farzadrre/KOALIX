<UserControl x:Class="Koalix.App.Views.LogsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:Koalix.App.Localization" xmlns:c="clr-namespace:Koalix.App.Controls">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="{l:T Logs.Title}" Style="{StaticResource Title}"/>
      <WrapPanel Margin="0,8,0,8">
        <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}"/>
        <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=300}" Width="240" ToolTip="{l:T Common.Search}"/>
        <Button Content="{l:T Logs.OpenFolder}" Command="{Binding OpenFolderCommand}"/>
        <Button Content="{l:T Logs.Export}" Command="{Binding ExportDiagnosticsCommand}" Style="{StaticResource AccentButton}"/>
        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Subtle}" VerticalAlignment="Center"/>
      </WrapPanel>
    </StackPanel>
    <Border Style="{StaticResource Card}" Padding="6">
      <DataGrid ItemsSource="{Binding Lines}" FlowDirection="LeftToRight" FontFamily="{StaticResource MonoFont}" FontSize="12">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Time" Binding="{Binding At, StringFormat=HH:mm:ss.fff}" Width="95"/>
          <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="85"/>
          <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="110"/>
          <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/>
        </DataGrid.Columns>
      </DataGrid>
    </Border>
  </DockPanel>
</UserControl>
