<UserControl x:Class="Koalix.App.Views.GamingView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="clr-namespace:Koalix.App.Localization" xmlns:c="clr-namespace:Koalix.App.Controls">
  <UserControl.Resources>
    <!-- Boost card: one reversible Windows optimization per card, applied instantly on toggle — like the console boosters, but journaled and verified.
         v0.4.5: the card lifts smoothly on hover and the status note fades in when it appears. -->
    <Style x:Key="BoostCard" TargetType="Border">
      <Setter Property="Width" Value="262"/>
      <Setter Property="Margin" Value="0,0,10,10"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="14,12"/>
      <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="RenderTransform"><Setter.Value><TranslateTransform/></Setter.Value></Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="BorderBrush" Value="{DynamicResource StrongBorderBrush}"/>
          <Trigger.EnterActions><BeginStoryboard><Storyboard>
            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Y" To="-3" Duration="0:0:0.16" EasingFunction="{StaticResource EaseOut}"/>
          </Storyboard></BeginStoryboard></Trigger.EnterActions>
          <Trigger.ExitActions><BeginStoryboard><Storyboard>
            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Y" To="0" Duration="0:0:0.26" EasingFunction="{StaticResource EaseOut}"/>
          </Storyboard></BeginStoryboard></Trigger.ExitActions>
        </Trigger>
      </Style.Triggers>
    </Style>
    <!-- Level-colored status note under each boost card (0 idle / 1 ok / 2 warn / 3 fail). -->
    <Style x:Key="BoostNote" TargetType="TextBlock">
      <Setter Property="FontSize" Value="10.5"/>
      <Setter Property="TextWrapping" Value="NoWrap"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
      <Setter Property="Margin" Value="0,9,0,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Note}" Value="{x:Null}">
          <Setter Property="Visibility" Value="Collapsed"/>
          <DataTrigger.EnterActions><BeginStoryboard><Storyboard>
            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0"/>
          </Storyboard></BeginStoryboard></DataTrigger.EnterActions>
          <DataTrigger.ExitActions><BeginStoryboard><Storyboard>
            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.3" EasingFunction="{StaticResource EaseOut}"/>
          </Storyboard></BeginStoryboard></DataTrigger.ExitActions>
        </DataTrigger>
        <DataTrigger Binding="{Binding Level}" Value="1"><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/></DataTrigger>
        <DataTrigger Binding="{Binding Level}" Value="2"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/></DataTrigger>
        <DataTrigger Binding="{Binding Level}" Value="3"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/></DataTrigger>
      </Style.Triggers>
    </Style>
    <!-- Needs-admin hint (only while KOALIX runs unelevated) — rounded rectangle (v0.4.13, was an oval). -->
    <Style x:Key="AdminHint" TargetType="Border">
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="8,2"/>
      <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}"/>
      <Setter Property="Visibility" Value="Collapsed"/>
      <Style.Triggers>
        <MultiDataTrigger>
          <MultiDataTrigger.Conditions>
            <Condition Binding="{Binding NeedsAdmin}" Value="True"/>
            <Condition Binding="{Binding DataContext.Elevated, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" Value="False"/>
          </MultiDataTrigger.Conditions>
          <Setter Property="Visibility" Value="Visible"/>
        </MultiDataTrigger>
      </Style.Triggers>
    </Style>
    <!-- Console tile (v0.4.3): PS5 / PS4 / Xbox Series / Switch — opens the per-console hotspot guide. -->
    <Style x:Key="ConsoleTile" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Margin" Value="0,0,8,8"/>
      <Setter Property="Padding" Value="12,10"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
  </UserControl.Resources>

  <Grid>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel x:Name="Root">
        <TextBlock Text="{l:T Gaming.Title}" Style="{StaticResource Title}"/>
        <TextBlock Text="{l:T Gaming.Subtitle}" Style="{StaticResource Subtitle}"/>

        <!-- ============ System boost grid (v0.4.3) ============ -->
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <Grid Margin="0,0,0,6">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal">
                <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource AccentSoftBrush}" Margin="0,0,10,0" VerticalAlignment="Center">
                  <TextBlock Text="&#xE9D9;" Style="{StaticResource Icon}" FontSize="16" HorizontalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="{l:T Gaming.Boost.Title}" Style="{StaticResource CardTitle}" Margin="0"/>
                  <TextBlock Text="{l:T Gaming.Boost.Subtitle}" Style="{StaticResource Subtle}" TextWrapping="Wrap" MaxWidth="480"/>
                </StackPanel>
              </StackPanel>
              <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                <!-- v0.4.23 (suggestion #7): the fullscreen minimal gaming surface — one click away. -->
                <Button Click="Focus_Click" ToolTip="{l:T Focus.EnterTip}" Margin="0,0,8,0">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7FC;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,7,0"/>
                    <TextBlock Text="{l:T Focus.Enter}" FontSize="12"/>
                  </StackPanel>
                </Button>
                <Button Command="{Binding ApplyAllCommand}" Style="{StaticResource AccentButton}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,7,0"/>
                    <TextBlock Text="{l:T Gaming.Boost.ApplyAll}" FontSize="12"/>
                  </StackPanel>
                </Button>
                <Button Command="{Binding RevertAllCommand}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,7,0"/>
                    <TextBlock Text="{l:T Gaming.Boost.RevertAll}" FontSize="12"/>
                  </StackPanel>
                </Button>
              </WrapPanel>
            </Grid>

            <ItemsControl x:Name="Boosts" ItemsSource="{Binding Boosts}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Style="{StaticResource BoostCard}" ToolTipService.InitialShowDelay="250" ToolTipService.ShowDuration="30000">
                    <Border.ToolTip>
                      <TextBlock MaxWidth="340" TextWrapping="Wrap" TextAlignment="Right">
                        <TextBlock.Text><MultiBinding Converter="{x:Static l:LocMulti.Instance}"><Binding Path="TipKey"/><Binding Path="Language" Source="{x:Static l:Loc.I}"/></MultiBinding></TextBlock.Text>
                      </TextBlock>
                    </Border.ToolTip>
                    <StackPanel>
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource AccentSoftBrush}">
                          <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="16" HorizontalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource AdminHint}" VerticalAlignment="Center">
                          <TextBlock Text="{l:T Gaming.Boost.NeedsAdmin}" FontSize="9.5" Foreground="{DynamicResource WarningBrush}"/>
                        </Border>
                      </Grid>
                      <TextBlock Margin="0,10,0,1" FontSize="13" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis">
                        <TextBlock.Text><MultiBinding Converter="{x:Static l:LocMulti.Instance}"><Binding Path="TitleKey"/><Binding Path="Language" Source="{x:Static l:Loc.I}"/></MultiBinding></TextBlock.Text>
                      </TextBlock>
                      <TextBlock FontSize="11" Foreground="{DynamicResource SubtleTextBrush}" TextWrapping="Wrap" MaxHeight="32" TextTrimming="CharacterEllipsis">
                        <TextBlock.Text><MultiBinding Converter="{x:Static l:LocMulti.Instance}"><Binding Path="DescKey"/><Binding Path="Language" Source="{x:Static l:Loc.I}"/></MultiBinding></TextBlock.Text>
                      </TextBlock>
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Note}" Style="{StaticResource BoostNote}"/>
                        <CheckBox Grid.Column="1" IsChecked="{Binding IsOn}" VerticalAlignment="Center" Margin="0,7,0,0">
                          <CheckBox.Style>
                            <Style TargetType="CheckBox" BasedOn="{StaticResource Switch}">
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding Busy}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </CheckBox.Style>
                        </CheckBox>
                      </Grid>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Margin="2,2,2,0"/>
          </StackPanel>
        </Border>

        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

          <!-- ============ Games (per-game routing) ============ -->
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="{l:T Gaming.Games}" Style="{StaticResource CardTitle}"/>
              <ListBox ItemsSource="{Binding Games}" SelectedItem="{Binding Selected}" HorizontalContentAlignment="Stretch" Height="220" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextBrush}">
                <ListBox.ItemTemplate><DataTemplate>
                  <Grid Margin="0,4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding ExecutablePath}" Style="{StaticResource Subtle}" FlowDirection="LeftToRight" TextTrimming="CharacterEllipsis"/></StackPanel>
                    <!-- v0.4.37 — per-game auto-activation: launch the game → connect + boost; close it → back to normal -->
                    <CheckBox Grid.Column="1" VerticalAlignment="Center" Margin="10,0,4,0" IsChecked="{Binding AutoActivate, Mode=OneWay}"
                              Command="{Binding DataContext.ToggleAutoCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"
                              Content="{l:T Gaming.Auto.Toggle}" ToolTip="{l:T Gaming.Auto.Hint}"/>
                  </Grid>
                </DataTemplate></ListBox.ItemTemplate>
              </ListBox>
              <WrapPanel Margin="0,8,0,0">
                <Button Content="{l:T Gaming.AddGame}" Command="{Binding AddGameCommand}" Style="{StaticResource AccentButton}"/>
                <Button Content="{l:T Gaming.Route}" Command="{Binding RouteThroughTunnelCommand}"/>
                <Button Command="{Binding BoostRunningCommand}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xEC05;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,7,0"/>
                    <TextBlock Text="{l:T Gaming.BoostRunning}" FontSize="12"/>
                  </StackPanel>
                </Button>
                <Button Content="{l:T Common.Delete}" Command="{Binding RemoveGameCommand}" Style="{StaticResource DangerButton}"/>
              </WrapPanel>
              <TextBlock Text="{l:T Gaming.Honest}" Style="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>
          </Border>

          <!-- ============ Console sharing (v0.4.3) ============ -->
          <Border Grid.Column="1" Style="{StaticResource Card}">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource AccentSoftBrush}" Margin="0,0,10,0" VerticalAlignment="Center">
                  <TextBlock Text="&#xE7FC;" Style="{StaticResource Icon}" FontSize="17" HorizontalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                </Border>
                <TextBlock Text="{l:T Gaming.Console.Title}" Style="{StaticResource CardTitle}" VerticalAlignment="Center" Margin="0"/>
              </StackPanel>

              <Border CornerRadius="10" Background="{DynamicResource AccentSoftBrush}" Padding="12,9" Margin="0,0,0,12">
                <TextBlock Text="{l:T Gaming.Console.Intro}" FontSize="12" TextWrapping="Wrap"/>
              </Border>

              <TextBlock Text="{l:T Gaming.Console.How}" FontWeight="Bold" FontSize="13" Margin="0,0,0,8"/>
              <ItemsControl ItemsSource="{Binding ConsoleSteps}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                      <Border Width="7" Height="7" CornerRadius="2.5" Background="{DynamicResource AccentBrush}" VerticalAlignment="Top" Margin="4,6,10,0"/>
                      <TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,0" VerticalAlignment="Top"/>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock Text="{l:T Gaming.Console.Pick}" FontWeight="Bold" FontSize="13" Margin="0,10,0,8"/>
              <UniformGrid Columns="2">
                <Button Style="{StaticResource ConsoleTile}" Command="{Binding ShowGuideCommand}" CommandParameter="PS5">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7FC;" Style="{StaticResource Icon}" FontSize="15" Foreground="{DynamicResource AccentBrush}" Margin="0,0,9,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{l:T Gaming.Console.PS5.Name}" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center"/>
                    <TextBlock Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="10" Foreground="{DynamicResource SubtleTextBrush}" Margin="7,1,0,0" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
                <Button Style="{StaticResource ConsoleTile}" Command="{Binding ShowGuideCommand}" CommandParameter="PS4">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7FC;" Style="{StaticResource Icon}" FontSize="15" Foreground="{DynamicResource AccentBrush}" Margin="0,0,9,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{l:T Gaming.Console.PS4.Name}" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center"/>
                    <TextBlock Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="10" Foreground="{DynamicResource SubtleTextBrush}" Margin="7,1,0,0" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
                <Button Style="{StaticResource ConsoleTile}" Command="{Binding ShowGuideCommand}" CommandParameter="Xbox">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7FC;" Style="{StaticResource Icon}" FontSize="15" Foreground="{DynamicResource AccentBrush}" Margin="0,0,9,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{l:T Gaming.Console.Xbox.Name}" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center"/>
                    <TextBlock Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="10" Foreground="{DynamicResource SubtleTextBrush}" Margin="7,1,0,0" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
                <Button Style="{StaticResource ConsoleTile}" Command="{Binding ShowGuideCommand}" CommandParameter="Switch">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7FC;" Style="{StaticResource Icon}" FontSize="15" Foreground="{DynamicResource AccentBrush}" Margin="0,0,9,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{l:T Gaming.Console.Switch.Name}" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center"/>
                    <TextBlock Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="10" Foreground="{DynamicResource SubtleTextBrush}" Margin="7,1,0,0" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
              </UniformGrid>

              <Border CornerRadius="12" Background="{DynamicResource ControlBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="12,10" Margin="0,12,0,0">
                <StackPanel>
                  <WrapPanel>
                    <Border Style="{StaticResource Pill}" Background="{DynamicResource ControlHoverBrush}" Margin="0,0,8,6">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE968;" Style="{StaticResource Icon}" FontSize="11" Foreground="{DynamicResource SubtleTextBrush}"/>
                        <TextBlock Text="{l:T Gaming.Console.PcIp}" Margin="6,0,0,0" FontSize="11"/>
                        <TextBlock Text="{Binding LocalIp}" Margin="6,0,0,0" FontSize="11.5" FontWeight="SemiBold" Style="{StaticResource Latin}"/>
                      </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Pill}" Background="{DynamicResource ControlHoverBrush}" Margin="0,0,0,6" Visibility="Collapsed">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE968;" Style="{StaticResource Icon}" FontSize="11" Foreground="{DynamicResource SubtleTextBrush}"/>
                        <TextBlock Text="{l:T Gaming.Console.Port}" Margin="6,0,0,0" FontSize="11"/>
                        <TextBlock Text="{Binding ProxyPort}" Margin="6,0,0,0" FontSize="11.5" FontWeight="SemiBold" Style="{StaticResource Latin}"/>
                      </StackPanel>
                    </Border>
                  </WrapPanel>
                  <WrapPanel>
                    <Button Command="{Binding OpenHotspotCommand}" Style="{StaticResource AccentButton}" Padding="12,6">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE701;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,7,0"/>
                        <TextBlock Text="{l:T Gaming.Console.OpenHotspot}" FontSize="12"/>
                      </StackPanel>
                    </Button>
                    <Button Command="{Binding CopyIpCommand}" Padding="12,6">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,7,0"/>
                        <TextBlock Text="{l:T Gaming.Console.CopyIp}" FontSize="12"/>
                      </StackPanel>
                    </Button>
                  </WrapPanel>
                </StackPanel>
              </Border>

              <!-- v0.4.36 - LAN proxy sharing: the second way (same modem / Wi-Fi, no hotspot needed). -->
              <Border CornerRadius="12" Background="{DynamicResource ControlBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="12,10" Margin="0,10,0,0">
                <StackPanel>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <TextBlock Text="&#xE704;" Style="{StaticResource Icon}" FontSize="15" Foreground="{DynamicResource AccentBrush}" Margin="0,0,9,0" VerticalAlignment="Center"/>
                      <TextBlock Text="{l:T Gaming.Lan.Title}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                    <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding LanEnabled}" VerticalAlignment="Center"/>
                  </Grid>
                  <TextBlock Text="{l:T Gaming.Lan.Desc}" Style="{StaticResource Subtle}" TextWrapping="Wrap" Margin="0,6,0,8"/>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="90"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{l:T Gaming.Console.Port}" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Grid.Column="1" Text="{Binding LanPort, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" Padding="6,3"/>
                    <TextBlock Grid.Column="2" Text="{l:T Gaming.Lan.Password}" FontSize="11.5" VerticalAlignment="Center" Margin="10,0,6,0"/>
                    <TextBox Grid.Column="3" Text="{Binding LanPassword, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight" Padding="6,3" ToolTip="{l:T Gaming.Lan.PasswordTip}"/>
                  </Grid>
                  <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <Ellipse Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                          <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{DynamicResource SubtleTextBrush}"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding LanLevel}" Value="1"><Setter Property="Fill" Value="#22C55E"/></DataTrigger>
                              <DataTrigger Binding="{Binding LanLevel}" Value="2"><Setter Property="Fill" Value="#F59E0B"/></DataTrigger>
                              <DataTrigger Binding="{Binding LanLevel}" Value="3"><Setter Property="Fill" Value="#EF4444"/></DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Ellipse.Style>
                      </Ellipse>
                      <TextBlock Text="{Binding LanStatus}" FontSize="11.5" TextWrapping="Wrap" MaxWidth="260" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                      <Button Command="{Binding CopyLanAddressCommand}" Padding="10,5" Margin="0,0,6,0" ToolTip="{l:T Gaming.Lan.CopyTip}">
                        <TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}" FontSize="12"/>
                      </Button>
                      <Button Command="{Binding SaveLanCommand}" Style="{StaticResource AccentButton}" Padding="12,5">
                        <TextBlock Text="{l:T Gaming.Lan.Apply}" FontSize="12"/>
                      </Button>
                    </StackPanel>
                  </Grid>
                  <TextBlock Text="{l:T Gaming.Lan.Udp}" Style="{StaticResource Subtle}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>
        </Grid>
      </StackPanel>
    </ScrollViewer>

    <!-- ============ Console guide popup (v0.4.3) ============ -->
    <Popup IsOpen="{Binding GuideOpen, Mode=TwoWay}" AllowsTransparency="True" StaysOpen="False"
           PlacementTarget="{Binding ElementName=Root}" Placement="Center" PopupAnimation="Fade">
      <Border Width="480" CornerRadius="16" Background="{DynamicResource PopupBrush}" BorderBrush="{DynamicResource StrongBorderBrush}" BorderThickness="1" Padding="22,18" Margin="60,20">
        <Border.Effect><DropShadowEffect BlurRadius="32" ShadowDepth="8" Opacity="0.45" Color="{DynamicResource ShadowColor}"/></Border.Effect>
        <StackPanel>
          <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
              <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Center">
                <TextBlock Text="{Binding GuideGlyph}" Style="{StaticResource Icon}" FontSize="18" HorizontalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
              </Border>
              <TextBlock Text="{Binding GuideTitle}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" Margin="11,0,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Command="{Binding CloseGuideCommand}" Style="{StaticResource IconButton}" Content="&#xE8BB;" VerticalAlignment="Center"/>
          </Grid>
          <ItemsControl ItemsSource="{Binding GuideSteps}" Margin="0,0,0,12">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
                  <Border Width="7" Height="7" CornerRadius="2.5" Background="{DynamicResource AccentBrush}" VerticalAlignment="Top" Margin="4,6,10,0"/>
                  <TextBlock Text="{Binding}" FontSize="12.5" TextWrapping="Wrap" VerticalAlignment="Top" MaxWidth="400"/>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <!-- v0.4.35: hidden — the local proxy listens on 127.0.0.1 only, so a console on the LAN can never reach it. -->
          <Border CornerRadius="10" Background="{DynamicResource AccentSoftBrush}" Padding="12,10" Margin="0,0,0,12" Visibility="Collapsed">
            <StackPanel>
              <TextBlock Text="{l:T Gaming.Console.GuideNote}" FontSize="11.5" TextWrapping="Wrap"/>
              <WrapPanel Margin="0,8,0,0">
                <Border Style="{StaticResource Pill}" Background="{DynamicResource ControlHoverBrush}" Margin="0,0,8,4">
                  <TextBlock Text="{Binding LocalIp}" FontSize="12" FontWeight="SemiBold" Style="{StaticResource Latin}"/>
                </Border>
                <Border Style="{StaticResource Pill}" Background="{DynamicResource ControlHoverBrush}" Margin="0,0,0,4">
                  <TextBlock Text="{Binding ProxyPort}" FontSize="12" FontWeight="SemiBold" Style="{StaticResource Latin}"/>
                </Border>
              </WrapPanel>
            </StackPanel>
          </Border>
          <WrapPanel>
            <Button Command="{Binding OpenHotspotCommand}" Style="{StaticResource AccentButton}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE701;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,7,0"/>
                <TextBlock Text="{l:T Gaming.Console.OpenHotspot}" FontSize="12"/>
              </StackPanel>
            </Button>
            <Button Command="{Binding CloseGuideCommand}" Content="{l:T Common.Close}"/>
          </WrapPanel>
        </StackPanel>
      </Border>
    </Popup>
  </Grid>
</UserControl>
