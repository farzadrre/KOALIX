<Window x:Class="Koalix.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Koalix.App.Localization"
        xmlns:svc="clr-namespace:Koalix.App.Services"
        xmlns:c="clr-namespace:Koalix.App.Controls"
        xmlns:vm="clr-namespace:Koalix.App.ViewModels"
        xmlns:v="clr-namespace:Koalix.App.Views"
        Title="KOALIX" Width="1300" Height="820" MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBrush}"
        FontFamily="{DynamicResource UiFont}" FontSize="13.5" Foreground="{DynamicResource TextBrush}"
        FlowDirection="{Binding Flow, Source={x:Static l:Loc.I}}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="-1" CornerRadius="12" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><v:DashboardView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DnsViewModel}"><v:DnsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProfilesViewModel}"><v:ProfilesView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SplitTunnelViewModel}"><v:SplitTunnelView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:InspectorViewModel}"><v:InspectorView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:PingViewModel}"><v:PingView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:RepairViewModel}"><v:RepairView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:GamingViewModel}"><v:GamingView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProxyViewModel}"><v:ProxyView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:LogsViewModel}"><v:LogsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><v:SettingsView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:AboutViewModel}"><v:AboutView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:GuideViewModel}"><v:GuideView/></DataTemplate>
    </Window.Resources>
    <Grid x:Name="Root">
        <!-- Tint over the Mica/Acrylic material + slowly drifting accent "aurora" blobs -->
        <Border Background="{DynamicResource ShellTintBrush}"/>
        <Canvas x:Name="Aurora" IsHitTestVisible="False" ClipToBounds="True" Opacity="{DynamicResource AuroraOpacity}" FlowDirection="LeftToRight">
            <!-- v0.4.13: blobs are rounded rectangles now (they are blurred glows, but the no-ovals rule is absolute). -->
            <Border x:Name="Blob1" Width="760" Height="760" CornerRadius="190" Canvas.Left="-160" Canvas.Top="-260" Background="{DynamicResource AuroraBrush1}"><Border.RenderTransform><TranslateTransform/></Border.RenderTransform></Border>
            <Border x:Name="Blob2" Width="680" Height="680" CornerRadius="170" Canvas.Left="760" Canvas.Top="380" Background="{DynamicResource AuroraBrush2}"><Border.RenderTransform><TranslateTransform/></Border.RenderTransform></Border>
            <Border x:Name="Blob3" Width="560" Height="560" CornerRadius="140" Canvas.Left="420" Canvas.Top="-200" Background="{DynamicResource AuroraBrush3}"><Border.RenderTransform><TranslateTransform/></Border.RenderTransform></Border>
        </Canvas>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Floating glass sidebar -->
            <Border Grid.RowSpan="2" Margin="10,10,0,10" CornerRadius="18" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="18,16,12,18">
                        <Grid Width="40" Height="40">
                            <Border CornerRadius="12" Background="{DynamicResource AccentBrush}" Opacity="0.45" Width="40" Height="40"><Border.Effect><BlurEffect Radius="14"/></Border.Effect></Border>
                            <Image Source="pack://application:,,,/KOALIX;component/Assets/koalix.png" Width="38" Height="38" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Grid>
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="KOALIX" FontFamily="{StaticResource LatinFont}" FontWeight="Black" FontSize="19" Foreground="{DynamicResource AccentTextGradientBrush}" TextWrapping="NoWrap"/>
                            <TextBlock Text="{l:T Main.Tagline}" Style="{StaticResource Subtle}" FontSize="11" TextWrapping="NoWrap"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Live connection card + Smart Mini Telemetry Footer (v0.4.41): always visible across all pages,
                         shows status dot, active server & flag, quick connect/disconnect toggle, live ping + download speed,
                         mini download sparkline, and installed engine / config lint chips. -->
                    <Border x:Name="StatusCard" DockPanel.Dock="Bottom" Margin="12" Padding="13,11" CornerRadius="14" Background="{DynamicResource ControlBrush}" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Cursor="Hand" c:Fx.HoverGlow="True" MouseLeftButtonUp="StatusCard_Click">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Grid Width="14" Height="14" VerticalAlignment="Center">
                                    <!-- v0.4.13: rounded-square status dot + halo (was circles) — no-ovals design rule. -->
                                    <Border x:Name="StatusHalo" Width="14" Height="14" CornerRadius="4.5" Background="{DynamicResource SubtleTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><ScaleTransform/></Border.RenderTransform></Border>
                                    <Border x:Name="StatusDot" Width="10" Height="10" CornerRadius="3.5" Background="{DynamicResource SubtleTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding StateText}" FontWeight="Bold" FontSize="12.5" TextWrapping="NoWrap"/>
                                        <c:FlagBox Code="{Binding Dash.TunnelGeo.Code}" Width="20" Height="14" Margin="7,0,0,0" VerticalAlignment="Center"
                                                   Visibility="{Binding Dash.HasTunnelGeo, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding StateDetail}" Style="{StaticResource Subtle}" FontSize="11" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource IconButton}" Padding="6" Margin="0" VerticalAlignment="Center"
                                        Command="{Binding Dash.ConnectCommand}" ToolTip="{Binding Dash.OrbLabel}">
                                    <TextBlock Text="&#xE7E8;" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource AccentBrush}"/>
                                </Button>
                            </Grid>

                            <!-- Live Mini Telemetry Strip (Ping + Download Speed + Mini Sparkline) -->
                            <Border Grid.Row="1" CornerRadius="10" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="9,6" Margin="0,8,0,0"
                                    Visibility="{Binding Dash.IsConnected, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <DockPanel ClipToBounds="True">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" FlowDirection="LeftToRight" VerticalAlignment="Center">
                                            <TextBlock Text="↓ " FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center"/>
                                            <TextBlock c:Fx.RollValue="{Binding Dash.Download}" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource LatinFont}" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" TextWrapping="NoWrap"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight" VerticalAlignment="Center">
                                            <TextBlock Text="⚡ " FontSize="10" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                            <TextBlock c:Fx.RollValue="{Binding Dash.Latency}" FontSize="11" FontWeight="SemiBold" FontFamily="{StaticResource LatinFont}" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" TextWrapping="NoWrap"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <c:Sparkline Values="{Binding Dash.DownHistory}" Stroke="{DynamicResource SuccessBrush}" Flow="True" Height="22" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <StackPanel Grid.Row="2" Orientation="Vertical" Margin="0,8,0,0" Visibility="{Binding IsAdvanced, Source={x:Static svc:UiMode.I}, Converter={StaticResource BoolToVis}}">
                                <!-- v0.4.19 (user: «فقط سینگ باکس و نوشته بقیه و چرا نمینویسه»): one chip per INSTALLED
                                     engine — sing-box, Xray, WireGuard, OpenVPN — not just the sing-box version. -->
                                <ItemsControl ItemsSource="{Binding EngineChips}" ToolTip="{l:T Settings.Engines}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="7" Padding="8,2" Background="{DynamicResource SuccessSoftBrush}" Margin="0,0,5,4">
                                                <TextBlock Text="{Binding}" FontSize="10.5" FontWeight="SemiBold" FontFamily="{StaticResource LatinFont}" FlowDirection="LeftToRight" TextWrapping="NoWrap"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Border CornerRadius="7" Padding="8,2" Background="{DynamicResource SuccessSoftBrush}" ToolTip="{l:T Main.LintTip}" HorizontalAlignment="Left">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LintLevel}" Value="1"><Setter Property="Background" Value="{DynamicResource DangerSoftBrush}"/></DataTrigger>
                                                <DataTrigger Binding="{Binding LintLevel}" Value="2"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding LintChipText}" FontSize="10.5" FontWeight="SemiBold" TextWrapping="NoWrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                <Setter Property="TextWrapping" Value="NoWrap"/>
                                                <Style.Triggers><DataTrigger Binding="{Binding LintLevel}" Value="1"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/></DataTrigger></Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- v0.4.42: in Beginner mode a quiet line under the menu says expert pages are tucked away — one click shows them. -->
                    <Button x:Name="ShowAdvancedHint" DockPanel.Dock="Bottom" Margin="12,0,12,2" Command="{Binding SetAdvancedModeCommand}" Cursor="Hand"
                            ToolTip="{l:T Mode.AdvancedTip}" FocusVisualStyle="{x:Null}"
                            Visibility="{Binding IsSimple, Source={x:Static svc:UiMode.I}, Converter={StaticResource BoolToVis}}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" CornerRadius="10" Padding="10,7" Background="Transparent" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE9E9;" Style="{StaticResource Icon}" FontSize="12" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{l:T Mode.HiddenHint}" FontSize="11.5" Foreground="{DynamicResource SubtleTextBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <ListBox x:Name="NavList" ItemsSource="{Binding Nav}" SelectedItem="{Binding Selected}" ItemContainerStyle="{StaticResource NavItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <!-- v0.4.13: each section's icon carries its own live motion while the section is active
                                         (DNS globe spins, gear rotates, wrench rocks …) — Fx.LiveMotion reads the nav key.
                                         v0.4.22 (user: «کاربر وقتی کلیک کنه روشون … فلش ها متحرک بشن»): the animated VECTOR logos
                                         (MotionGlyph) now come alive exactly when their section is CLICKED — the ListBoxItem
                                         IsSelected trigger below flips MotionGlyph.IsActive; idle items stay calm and static.
                                         Reports (گزارش‌ها) joined the family: its bars rise and fall while the page is open. -->
                                    <Grid Width="22" Height="20">
                                        <TextBlock x:Name="GlyphText" Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" c:Fx.LiveMotion="{Binding Key}"/>
                                        <c:MotionGlyph x:Name="LiveGlyph" Key="{Binding Key}" Width="19" Height="17" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" FontSize="13.5" FontWeight="SemiBold" TextWrapping="NoWrap">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{x:Static l:LocMulti.Instance}">
                                                <Binding Path="Key"/><Binding Path="Language" Source="{x:Static l:Loc.I}"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <!-- v0.4.22 — THE CLICK RULE: the vector logo animates while its section is open. -->
                                    <DataTrigger Value="True">
                                        <DataTrigger.Binding><Binding Path="IsSelected" RelativeSource="{RelativeSource AncestorType=ListBoxItem}"/></DataTrigger.Binding>
                                        <Setter TargetName="LiveGlyph" Property="c:MotionGlyph.IsActive" Value="True"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Key}" Value="Nav.Split">
                                        <Setter TargetName="GlyphText" Property="Visibility" Value="Collapsed"/>
                                        <Setter TargetName="LiveGlyph" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Key}" Value="Nav.Inspector">
                                        <Setter TargetName="GlyphText" Property="Visibility" Value="Collapsed"/>
                                        <Setter TargetName="LiveGlyph" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Key}" Value="Nav.Ping">
                                        <Setter TargetName="GlyphText" Property="Visibility" Value="Collapsed"/>
                                        <Setter TargetName="LiveGlyph" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Key}" Value="Nav.Logs">
                                        <Setter TargetName="GlyphText" Property="Visibility" Value="Collapsed"/>
                                        <Setter TargetName="LiveGlyph" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Key}" Value="Nav.About">
                                        <Setter TargetName="GlyphText" Property="Visibility" Value="Collapsed"/>
                                        <Setter TargetName="LiveGlyph" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Title bar: state chip + command palette + notification bell + quick toggles + caption buttons -->
            <DockPanel x:Name="TitleBar" Grid.Row="0" Grid.Column="1" LastChildFill="False" Margin="16,4,6,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" FlowDirection="LeftToRight">
                    <Button x:Name="ThemeButton" Style="{StaticResource TitleBarButton}" Content="&#xE793;" FontSize="13" ToolTip="{l:T Main.Theme}" Command="{Binding ToggleThemeCommand}" Click="ThemeButton_Click"/>
                    <Button Style="{StaticResource TitleBarButton}" Content="{Binding LangSwitchLabel}" FontFamily="{DynamicResource UiFont}" FontSize="12" FontWeight="SemiBold" ToolTip="{l:T Settings.Language}" Command="{Binding ToggleLanguageCommand}"/>
                    <Border Width="1" Height="18" Margin="6,0" Background="{DynamicResource BorderBrush}"/>
                    <Button Style="{StaticResource TitleBarButton}" Content="&#xE921;" Click="Minimize_Click"/>
                    <Button x:Name="MaxButton" Style="{StaticResource TitleBarButton}" Content="&#xE922;" Click="Maximize_Click"/>
                    <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="Close_Click"/>
                </StackPanel>
                <!-- v0.4.42 — Beginner / Advanced switch, always in sight (user: «بیاریش رو نوار بالای صفحه که تو دید باشه»). -->
                <c:ModeToggle x:Name="ModeSwitch" DockPanel.Dock="Right" Margin="0,0,10,0"/>
                <!-- v0.4.42 — "new version" badge: shown on every launch while an update is waiting; click = install / download. -->
                <Button DockPanel.Dock="Right" Margin="0,0,10,0" VerticalAlignment="Center" Cursor="Hand" Command="{Binding OpenUpdateCommand}"
                        ToolTip="{l:T Update.BadgeTip}" Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" CornerRadius="10" Padding="10,4" Background="{DynamicResource AccentBrush}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="White" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding UpdateBadgeText}" Margin="6,0,0,0" FontSize="12" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" TextWrapping="NoWrap"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.85"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <!-- v0.4.6: rounded rectangle (was a full capsule) — sits calmer next to the search field. -->
                <Border x:Name="StateChip" DockPanel.Dock="Left" CornerRadius="10" Padding="12,4" VerticalAlignment="Center" Background="{DynamicResource ControlBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="ChipDot" Width="8" Height="8" CornerRadius="3" Background="{DynamicResource SubtleTextBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding StateText}" Margin="8,0,0,0" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="NoWrap"/>
                    </StackPanel>
                </Border>
                <!-- Command palette trigger (v0.4.3, also Ctrl+K) — v0.4.6: rounded rectangle (was a full capsule). -->
                <Button x:Name="SearchChip" DockPanel.Dock="Left" Margin="10,0,0,0" VerticalAlignment="Center" Click="SearchChip_Click" ToolTip="{l:T Main.Palette}" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="b" Width="235" Height="32" Background="{DynamicResource ControlBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="13,0">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="b" Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
                                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource StrongBorderBrush}"/>
                                                <Setter TargetName="b" Property="TextElement.Foreground" Value="{DynamicResource TextBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource ControlPressedBrush}"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center"/>
                            <!-- UiFont: the IconFont has no Arabic glyphs — Persian label rendered as garbage without this override. -->
                            <TextBlock Text="{l:T Main.Palette}" FontFamily="{DynamicResource UiFont}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border Grid.Column="1" CornerRadius="6" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="10,0,0,0" Padding="7,1" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="Ctrl+K" FontFamily="{StaticResource MonoFont}" FontSize="10.5" Style="{StaticResource Latin}"/>
                        </Border>
                    </Grid>
                </Button>
                <!-- Notification center trigger (v0.4.3): bell + unread dot -->
                <Grid x:Name="BellWrap" DockPanel.Dock="Left" Width="40" Height="34" VerticalAlignment="Center" Margin="4,0,0,0">
                    <Button x:Name="BellButton" Style="{StaticResource TitleBarButton}" Content="&#xEA8F;" Click="Bell_Click" ToolTip="{l:T Notif.Title}"/>
                    <Border x:Name="NotifBadge" Width="9" Height="9" CornerRadius="3" Background="{DynamicResource DangerBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,7,10,0" Visibility="Collapsed"/>
                </Grid>
            </DockPanel>

            <!-- Page host (fade/slide transition on navigation) -->
            <ContentControl x:Name="PageHost" Grid.Row="1" Grid.Column="1" Content="{Binding Selected.Page}" Margin="26,6,12,12" Focusable="False">
                <ContentControl.RenderTransform><TranslateTransform/></ContentControl.RenderTransform>
            </ContentControl>

            <!-- Command palette (v0.4.3, Ctrl+K) -->
            <Popup x:Name="PalettePopup" AllowsTransparency="True" StaysOpen="False" PlacementTarget="{Binding ElementName=Root}" Placement="Center" VerticalOffset="-120" PopupAnimation="Fade" Focusable="False">
                <Border Width="620" MaxHeight="500" CornerRadius="16" Background="{DynamicResource PopupBrush}" BorderBrush="{DynamicResource StrongBorderBrush}" BorderThickness="1">
                    <Border.Effect><DropShadowEffect BlurRadius="36" ShadowDepth="8" Opacity="0.45" Color="{DynamicResource ShadowColor}"/></Border.Effect>
                    <StackPanel>
                        <Grid Margin="16,14,16,4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center" Foreground="{DynamicResource SubtleTextBrush}"/>
                            <Grid Grid.Column="1" Margin="10,0,0,0">
                                <TextBox x:Name="PaletteBox" FontSize="14" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center"
                                         Text="{Binding PaletteQuery, UpdateSourceTrigger=PropertyChanged}" KeyDown="PaletteBox_KeyDown"/>
                                <TextBlock Text="{l:T Palette.Placeholder}" Margin="2,0,0,0" FontSize="13" Foreground="{DynamicResource SubtleTextBrush}" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=PaletteBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Grid>
                        <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="14,4,14,4"/>
                        <ListBox x:Name="PaletteList" ItemsSource="{Binding PaletteResults}" Margin="8,2,8,10" BorderThickness="0" Background="Transparent" MaxHeight="380"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" PreviewMouseLeftButtonUp="PaletteList_Click" KeyboardNavigation.DirectionalNavigation="Contained">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="2,2">
                                        <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource AccentSoftBrush}">
                                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="13" HorizontalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/>
                                        </Border>
                                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center" MaxWidth="480">
                                            <!-- LTR: profile titles are Latin — keeps "VLESS - Clean IP : 1.2.3.4" segments in order; Persian titles still shape correctly inside an LTR line. -->
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FlowDirection="LeftToRight" TextTrimming="WordEllipsis" TextWrapping="NoWrap"/>
                                            <TextBlock Text="{Binding Sub}" Style="{StaticResource Subtle}" FontSize="11" FlowDirection="LeftToRight" TextTrimming="WordEllipsis" TextWrapping="NoWrap"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="{l:T Palette.Empty}" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,16">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Subtle}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding Items.Count, ElementName=PaletteList}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Popup>

            <!-- Notification center (v0.4.3) -->
            <Popup x:Name="NotifPopup" AllowsTransparency="True" StaysOpen="False" PlacementTarget="{Binding ElementName=BellWrap}" Placement="Bottom" VerticalOffset="6" PopupAnimation="Fade" Focusable="False">
                <Border Width="400" MaxHeight="460" CornerRadius="16" Background="{DynamicResource PopupBrush}" BorderBrush="{DynamicResource StrongBorderBrush}" BorderThickness="1">
                    <Border.Effect><DropShadowEffect BlurRadius="30" ShadowDepth="7" Opacity="0.4" Color="{DynamicResource ShadowColor}"/></Border.Effect>
                    <Grid Margin="8,8,8,10">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <DockPanel Margin="8,6,8,6">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" FlowDirection="LeftToRight">
                                <Button Style="{StaticResource IconButton}" Content="&#xE9F9;" Click="NotifDiagnose_Click" ToolTip="{l:T Notif.Diagnose}"/>
                                <Button Style="{StaticResource IconButton}" Content="&#xE107;" Click="NotifClear_Click" ToolTip="{l:T Notif.Clear}"/>
                            </StackPanel>
                            <TextBlock Text="{l:T Notif.Title}" FontWeight="Bold" VerticalAlignment="Center"/>
                        </DockPanel>
                        <ListBox x:Name="NotifList" Grid.Row="1" ItemsSource="{Binding Source={x:Static svc:Toasts.History}}" MaxHeight="360" Margin="4,0" BorderThickness="0" Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2,3">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Border Width="30" Height="30" CornerRadius="8" VerticalAlignment="Top">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Message.Kind}" Value="Success"><Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Message.Kind}" Value="Warning"><Setter Property="Background" Value="{DynamicResource WarningSoftBrush}"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Message.Kind}" Value="Error"><Setter Property="Background" Value="{DynamicResource DangerSoftBrush}"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Message.Glyph}" Style="{StaticResource Icon}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Message.Title}" FontWeight="SemiBold" FontSize="12.5" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Message.Text}" FontSize="11">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Subtle}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers><DataTrigger Binding="{Binding Message.Text}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding At, StringFormat=HH:mm:ss}" FontSize="10" FontFamily="{StaticResource LatinFont}" FlowDirection="LeftToRight"
                                                   Foreground="{DynamicResource SubtleTextBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Grid.Row="1" Text="{l:T Notif.Empty}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,30">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Subtle}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding Items.Count, ElementName=NotifList}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
            </Popup>

            <!-- Toast -->
            <Border x:Name="Toast" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,26" Padding="16,12" MinWidth="320" MaxWidth="560"
                    CornerRadius="14" Background="{DynamicResource PopupBrush}" BorderThickness="1" BorderBrush="{DynamicResource StrongBorderBrush}" Visibility="Collapsed" IsHitTestVisible="True" MouseLeftButtonUp="Toast_Click">
                <Border.Effect><DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.4" Color="{DynamicResource ShadowColor}"/></Border.Effect>
                <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Border x:Name="ToastIconBg" Width="34" Height="34" CornerRadius="10" VerticalAlignment="Top">
                        <TextBlock x:Name="ToastIcon" Style="{StaticResource Icon}" FontSize="16" Foreground="White" HorizontalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="ToastTitle" FontWeight="Bold" FontSize="14"/>
                        <TextBlock x:Name="ToastText" Style="{StaticResource Subtle}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- v0.4.22 — first-run onboarding tour (user: «برای کسایی که اولین بار وارد میشن یک بخش بزار که اموزشی
             طور باشه و کامل بهشون توضیح بده … حتی بهشون بگه که باید از تو تنظیمات اپ اون چیزارو نصب کنن»).
             Auto-opens on the very first launch; replayable any time from Settings ← دیدن دوبارهٔ راهنمای شروع. -->
        <Border x:Name="OnboardingOverlay" Visibility="Collapsed" Background="#CC0D1017" Focusable="True" KeyDown="OnboardingOverlay_KeyDown">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition/></Grid.RowDefinitions>
                <!-- aligned with the page host area so the card reads as part of the app, floating over everything -->
                <v:OnboardingView x:Name="Onboarding" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="26,0,12,0"/>
            </Grid>
        </Border>

        <!-- v0.4.23 — gaming FOCUS mode (suggestion #7): one fullscreen minimal surface for playing —
             status, live ping, traffic and the big disconnect button, nothing else. Esc exits. -->
        <Border x:Name="FocusOverlay" Visibility="Collapsed" Background="{DynamicResource WindowBrush}" Focusable="True" KeyDown="FocusOverlay_KeyDown">
            <Border x:Name="FocusDim" Background="Transparent">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <!-- v0.4.35 — focus «sonar»: a breathing accent glow + three rings that keep pinging outward behind the
                         latency number while focus mode is open (stopped on exit). -->
                    <Grid x:Name="FocusSonar" Grid.Row="1" Width="520" Height="520" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                        <Ellipse x:Name="FocusGlow" Width="360" Height="360" Opacity="0.16" Fill="{DynamicResource AccentBrush}" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.Effect><BlurEffect Radius="90"/></Ellipse.Effect>
                            <Ellipse.RenderTransform><ScaleTransform/></Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse x:Name="FocusRing1" Width="300" Height="300" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" Opacity="0" RenderTransformOrigin="0.5,0.5"><Ellipse.RenderTransform><ScaleTransform/></Ellipse.RenderTransform></Ellipse>
                        <Ellipse x:Name="FocusRing2" Width="300" Height="300" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" Opacity="0" RenderTransformOrigin="0.5,0.5"><Ellipse.RenderTransform><ScaleTransform/></Ellipse.RenderTransform></Ellipse>
                        <Ellipse x:Name="FocusRing3" Width="300" Height="300" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" Opacity="0" RenderTransformOrigin="0.5,0.5"><Ellipse.RenderTransform><ScaleTransform/></Ellipse.RenderTransform></Ellipse>
                    </Grid>
                    <Button Style="{StaticResource TitleBarButton}" Content="&#xE8BB;" HorizontalAlignment="Right" Margin="0,14,14,0" Click="FocusClose_Click" ToolTip="{l:T Focus.Exit}"/>
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="40,0" TextBlock.TextAlignment="Center">
                        <StackPanel x:Name="FocusHead" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Border x:Name="FocusDot" Width="16" Height="16" CornerRadius="5" Background="{DynamicResource SubtleTextBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding StateText}" FontSize="30" FontWeight="Black" Margin="14,0,0,0" VerticalAlignment="Center" TextWrapping="NoWrap"/>
                        </StackPanel>
                        <TextBlock x:Name="FocusDetail" Text="{Binding StateDetail}" Style="{StaticResource Subtle}" FontSize="15" Margin="0,8,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="FocusPing" Text="{Binding Dash.Latency}" FontSize="86" RenderTransformOrigin="0.5,0.5" FontWeight="Black" Margin="0,26,0,0" Foreground="{DynamicResource AccentTextGradientBrush}" FontFamily="{StaticResource LatinFont}" FlowDirection="LeftToRight" TextWrapping="NoWrap"/>
                        <!-- v0.4.36 — live ping chart (last 90 s) + sudden-spike badge -->
                        <Grid Width="420" Height="64" Margin="0,2,0,8" HorizontalAlignment="Center" FlowDirection="LeftToRight" IsHitTestVisible="False">
                            <c:Sparkline Values="{Binding Dash.LatencyHistory}" Stroke="{DynamicResource AccentGradientBrush}" Opacity="0.9"/>
                        </Grid>
                        <Border CornerRadius="10" Padding="12,4" Margin="0,0,0,8" HorizontalAlignment="Center" Background="#33EF4444" BorderBrush="#EF4444" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding Dash.PingSpiking}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="12" Foreground="#EF4444" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Dash.PingSpikeText}" FontSize="12" FontWeight="SemiBold" Foreground="#EF4444" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <StackPanel x:Name="FocusPills" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                            <Border Style="{StaticResource Pill}" Background="{DynamicResource ControlBrush}" Padding="12,4" Margin="5,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{l:T Dash.Upload}" Style="{StaticResource Subtle}" FontSize="11.5" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Dash.Upload}" Margin="8,0,0,0" FontSize="11.5" FontWeight="SemiBold" FontFamily="{StaticResource LatinFont}" FlowDirection="LeftToRight" VerticalAlignment="Center" TextWrapping="NoWrap"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Pill}" Background="{DynamicResource ControlBrush}" Padding="12,4" Margin="5,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{l:T Dash.Download}" Style="{StaticResource Subtle}" FontSize="11.5" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Dash.Download}" Margin="8,0,0,0" FontSize="11.5" FontWeight="SemiBold" FontFamily="{StaticResource LatinFont}" FlowDirection="LeftToRight" VerticalAlignment="Center" TextWrapping="NoWrap"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Pill}" Background="{DynamicResource ControlBrush}" Padding="12,4" Margin="5,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{l:T Focus.Uptime}" Style="{StaticResource Subtle}" FontSize="11.5" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Dash.Uptime}" Margin="8,0,0,0" FontSize="11.5" FontWeight="SemiBold" FontFamily="{StaticResource LatinFont}" FlowDirection="LeftToRight" VerticalAlignment="Center" TextWrapping="NoWrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <Button x:Name="FocusConnect" Command="{Binding Dash.ConnectCommand}" Style="{StaticResource DangerButton}" Padding="34,12" FontSize="16" FontWeight="Bold" Margin="0,34,0,0" HorizontalAlignment="Center">
                            <TextBlock TextWrapping="NoWrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Setter Property="Text" Value="{l:T Cmd.Connect}"/>
                                        <Style.Triggers><DataTrigger Binding="{Binding Dash.IsConnected}" Value="True"><Setter Property="Text" Value="{l:T Cmd.Disconnect}"/></DataTrigger></Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                    </StackPanel>
                    <TextBlock Grid.Row="2" Text="{l:T Focus.Exit}" Style="{StaticResource Subtle}" FontSize="11.5" HorizontalAlignment="Center" Margin="0,0,0,18"/>
                </Grid>
            </Border>
        </Border>

        <!-- v0.4.23 → v0.4.24 — the theme switch is now a CIRCULAR WAVE («تعویض تم تیره/روشن با موج دایره‌ای
             که از دکمهٔ خورشید پخش می‌شود»): the old look is snapshotted on top; after the resources flip, a
             disc of the NEW theme colour expands from the sun button, washing over the old look, then the whole
             overlay fades away. Falls back to the plain cross-fade path when the button origin is unknown. -->
        <Grid x:Name="ThemeOverlay" Visibility="Collapsed" IsHitTestVisible="False">
            <!-- v0.4.34: LeftToRight so the clip maths runs in screen space; the RTL mirror itself is undone in code (TransformedBitmap flip). v0.4.33 note: the bitmap is captured in Root logical space; in Persian (RTL) the
                 inherited mirror flipped it, so the old look appeared mirrored for the length of the reveal. -->
            <Image x:Name="ThemeSnapshot" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top" FlowDirection="LeftToRight"/>
            <Ellipse x:Name="ThemeWave" Visibility="Collapsed" Fill="{DynamicResource WindowBrush}" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform><ScaleTransform x:Name="ThemeWaveScale" ScaleX="0" ScaleY="0"/></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="ThemeRing" Visibility="Collapsed" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2.5" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform><ScaleTransform x:Name="ThemeRingScale" ScaleX="0" ScaleY="0"/></Ellipse.RenderTransform>
            </Ellipse>
        </Grid>

        <!-- v0.4.35 — CONNECT HALO («وقتی وصل میشه یک حالهٔ رنگی دور دکمهٔ اتصال شروع شه و بره تا کل اپ … موقع قطع
             هم همینجور»): a coloured wash + two glowing rings expand from the connect orb over the whole window on
             connect (green → accent); on disconnect they fall back INTO the orb (red). Pure overlay, never hit-tested. -->
        <Canvas x:Name="ConnectFx" Visibility="Collapsed" IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse x:Name="ConnectFxWash" RenderTransformOrigin="0.5,0.5"><Ellipse.RenderTransform><ScaleTransform/></Ellipse.RenderTransform></Ellipse>
            <Ellipse x:Name="ConnectFxRing" RenderTransformOrigin="0.5,0.5"><Ellipse.RenderTransform><ScaleTransform/></Ellipse.RenderTransform></Ellipse>
            <Ellipse x:Name="ConnectFxRing2" RenderTransformOrigin="0.5,0.5"><Ellipse.RenderTransform><ScaleTransform/></Ellipse.RenderTransform></Ellipse>
        </Canvas>
    </Grid>
</Window>
